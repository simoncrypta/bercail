#!/usr/bin/env bash
# bstack's op for a repo with a desk secret. The guard puts this folder first
# on PATH and names the token file in BERCAIL_OP_SERVICE_ACCOUNT. The token is
# read here, each time, and only op's own environment gets it; /usr/bin/op
# keeps the 1Password app's prompt (docs/config.md#a-desk-secret-per-repo).
set -euo pipefail

# The real op, from where packages install it and never from PATH, and only one
# you cannot write or replace: an op put ahead of it would get the token.
real=""
for candidate in /usr/bin/op /usr/local/bin/op /opt/homebrew/bin/op; do
  [[ -x "$candidate" && ! -w "$candidate" && ! -w "${candidate%/*}" ]] && { real="$candidate"; break; }
done
[[ -n "$real" ]] || {
  printf 'op: no 1Password CLI you cannot write in /usr/bin, /usr/local/bin or /opt/homebrew/bin\n' >&2
  exit 127
}

file="${BERCAIL_OP_SERVICE_ACCOUNT:-}"
[[ -n "$file" ]] || exec "$real" "$@"
unset BERCAIL_OP_SERVICE_ACCOUNT

if [[ "$file" == *.cred ]]; then
  token="$(systemd-creds decrypt --user "$file" - | tr -d '\r\n')"
else
  token="$(tr -d '\r\n' <"$file")"
fi
[[ -n "$token" ]] || { printf 'op: the desk secret %s is empty\n' "$file" >&2; exit 1; }

# op run and op plugin run give their child op's environment, token included:
# take it back out.
args=("$@")
i=0
while ((i < ${#args[@]})) && [[ "${args[i]}" == -* ]]; do
  case "${args[i]}" in
    --account | --config | --encoding | --format | --session) i=$((i + 2)) ;;
    *) i=$((i + 1)) ;;
  esac
done
if [[ "${args[i]:-}" == run || "${args[i]:-} ${args[i + 1]:-}" == "plugin run" ]]; then
  for ((j = i + 1; j < ${#args[@]}; j++)); do
    [[ "${args[j]}" == -- ]] && break
  done
  if ((j < ${#args[@]})); then
    args=("${args[@]:0:j+1}" env -u OP_SERVICE_ACCOUNT_TOKEN "${args[@]:j+1}")
  elif [[ " ${args[*]} " != *" --help "* && " ${args[*]} " != *" -h "* ]]; then
    printf 'op: write op run with -- before the command: op run [flags] -- COMMAND\n' >&2
    exit 2
  fi
fi

export OP_SERVICE_ACCOUNT_TOKEN="$token"
exec "$real" "${args[@]}"
