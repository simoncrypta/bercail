[layout]
# Bare "tuicr" expands to `tuicr -w` (uncommitted changes only, watching;
# agents stage and do not commit) or `tuicr pr N` for someone else's PR.
review = "tuicr"
# Open Review when the desk agent finishes. Set false to open it only with Ctrl+Shift+R.
auto_review = true
# true: the terminal under the pointer gets the keyboard (the desk, Shell, Review, Shep).
# Read when the Herdr app starts.
focus_follows_mouse = false

[bstack]
# Pi with your own Claude and ChatGPT subscriptions. Setup installs the Claude
# bridge. Sign in with `claude auth login` and /login openai. On a rate limit a
# role pauses until it resets; Claude Fable stands in for the judge while GPT is
# limited, and for a role on Opus while a limit holds Opus alone.
# A model per provider. Empty: auto, the newest model of each connected plan
# (re-picked on bercail update). Set a provider/model id to pin one; :high sets its level.
# Claude on Pi: claude-bridge/claude-opus-5-5, not anthropic/claude-opus-5-5.
claude = ""
fable = ""
gpt = ""
# Reasoning effort of auto models: low, medium, high, xhigh, max, or none (the
# provider's default). A model without that level gets the next one down.
effort = "high"
# Which provider each role uses: claude, gpt, fable, or a full model id. The
# judge on gpt takes fable, then claude, until ChatGPT is connected.
lead = "claude"
build = "claude"
judge = "gpt"

# [git]
# Git backend per repo: gh (git + GitHub CLI), gt (Graphite), or origin (Cursor
# Origin). Keys are main-checkout paths; linked worktrees share that choice.
# Without an override: real Graphite tracking, then Cursor Origin, else gh.
# "~/Work/some-repo" = "gh"
# "~/Work/graphite-repo" = "gt"
# "~/Work/origin-repo" = "origin"
