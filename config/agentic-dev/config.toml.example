[agent]
# Intended sticky agent is cursor-agent. The cursor handoff stage uses
# cursor-agent + /poteto-mode (pstack). The start stage is headless claude
# and does not read this command. To put another command in the left
# pane, set this yourself, then run: bercail reconfigure
command = "cursor-agent"

[layout]
# Bare "tuicr" expands to `tuicr -r origin/main -w` on a feature branch
# (watching committed + uncommitted) or `tuicr pr N` for someone else's PR.
review = "tuicr"
# Open tuicr when the layout agent pane goes done. Set false to disable the hook.
auto_review = true
# Omit editor to use $EDITOR / $VISUAL (Linux) or nano/vi (macOS).
# editor = "nvim"
