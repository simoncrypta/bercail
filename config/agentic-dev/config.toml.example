[agent]
# Sticky left-pane agent. Handoff stages do not read this command; each
# stage names its own binary (claude, codex, or cursor-agent). To put
# another command in the left pane, set it here, then run: bercail reconfigure
command = "cursor-agent"

[layout]
# Bare "tuicr" expands to `tuicr -w` (uncommitted changes only, watching;
# agents stage and do not commit) or `tuicr pr N` for someone else's PR.
review = "tuicr"
# Open tuicr when the layout agent pane goes done. Set false to disable the hook.
auto_review = true
# Omit editor to use $EDITOR / $VISUAL (Linux) or nano/vi (macOS).
# editor = "nvim"
