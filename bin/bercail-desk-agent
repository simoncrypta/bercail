#!/usr/bin/env bash
# The desk agent. Usage: bercail-desk-agent [--prompt TEXT] [COMMAND [ARGS...]]
#
# COMMAND defaults to opencode when bstack is on ([bstack] enabled = true),
# else bercail's [agent] command. opencode with bstack on gets the terminal's
# palette (the system theme) and runs bstack, its default agent. The full TUI,
# not `opencode mini`: only the full TUI reports its status (OSC 7501), which
# the desk column's header and Review's auto-open read. With [bstack]
# harness = "pi" it is Pi with the lead's profile, which bercail update writes.
set -euo pipefail

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/bercail/config.toml"
PI_LEAD="$HOME/.local/share/bercail/pi/lead.json"
# Every Pi desk loads it: it tells the record which session runs there.
PI_DESK_EXTENSION="$HOME/.local/share/bercail/pi-extensions/bercail-desk.ts"
# Tabs off: the TUI then reports only its own session, not the other sessions
# open in this folder.
CLI_CONFIG='{"theme":{"name":"system","mode":"system"},"highlights":false,"tabs":{"mode":"off"}}'

# Value of KEY in [SECTION] of config.toml, unquoted.
toml_get() {
  [[ -r "$CONFIG" ]] || return 0
  awk -v want="[$1]" -v key="$2" '
    /^[[:space:]]*\[/ { sec = $0; gsub(/[[:space:]]/, "", sec); next }
    sec != want { next }
    $0 ~ "^[[:space:]]*" key "[[:space:]]*=" {
      sub("^[^=]*=[[:space:]]*", ""); sub(/[[:space:]]*#.*$/, ""); gsub(/^"|"$/, ""); print; exit
    }' "$CONFIG"
}

prompt=""
if [[ "${1:-}" == --prompt ]]; then
  prompt="${2:-}"
  shift 2 || shift $#
fi

bstack=0 on_pi=0
[[ "$(toml_get bstack enabled)" == true ]] && bstack=1
[[ "$bstack" -eq 1 && "$(toml_get bstack harness)" == pi ]] && on_pi=1

argv=("$@")
if [[ ${#argv[@]} -eq 0 ]]; then
  if [[ "$on_pi" -eq 1 ]]; then
    [[ -r "$PI_LEAD" ]] || {
      printf 'bercail-desk-agent: %s is missing; run bercail update\n' "$PI_LEAD" >&2
      exit 1
    }
    while IFS= read -r -d '' arg; do
      argv+=("$arg")
    done < <(jq -j '.[] | ., "\u0000"' "$PI_LEAD")
  elif [[ "$bstack" -eq 1 ]]; then
    argv=(opencode)
  else
    read -r -a argv <<<"$(toml_get agent command)"
    [[ ${#argv[@]} -gt 0 ]] || argv=(cursor-agent)
  fi
fi

# An idle harness writes nothing. Heartbeat the record, using hc events to
# notice its exit without waiting a full minute. Session identity comes from
# the TUI plugin or Claude hook, not hc's turn-only status reports.
watch_desk() {
  local pid="$1" record="$2" events
  trap '' INT
  exec </dev/null >/dev/null 2>&1
  while kill -0 "$pid"; do
    exec 3< <(hc events --json --terminal "$HC_TERMINAL_ID")
    events=$!
    while kill -0 "$pid"; do
      touch -c "$record"
      if IFS= read -r -t 60 -u 3 _; then
        continue
      elif (($? <= 128)); then
        break
      fi
    done
    kill "$events"
    exec 3<&-
    kill -0 "$pid" && sleep 5
  done
}

# 0 when FLAG takes the next argv word. An equals form already holds its value.
# Only listed flags do. A value is not a subcommand (`opencode --prompt run`
# stays a desk); a word after a boolean flag is (`opencode --print-logs run`).
flag_has_value() {
  case "$1 $2" in
    "opencode --server" | "opencode --completions" | "opencode --log-level" \
      | "codex -c" | "codex --config" | "codex --enable" | "codex --disable" \
      | "codex --remote" | "codex --remote-auth-token-env" | "codex -i" | "codex --image" \
      | "codex -m" | "codex --model" | "codex --local-provider" | "codex -p" | "codex --profile" \
      | "codex -s" | "codex --sandbox" | "codex -C" | "codex --cd" | "codex --add-dir" \
      | "codex -a" | "codex --ask-for-approval" \
      | "claude --add-dir" | "claude --agent" | "claude --agents" \
      | "claude --allowedTools" | "claude --allowed-tools" | "claude --append-system-prompt" \
      | "claude --autocompact" | "claude --betas" | "claude --cloud" | "claude -d" | "claude --debug" \
      | "claude --debug-file" | "claude --disallowedTools" | "claude --disallowed-tools" \
      | "claude --effort" | "claude --environment" | "claude --fallback-model" | "claude --file" \
      | "claude --from-pr" | "claude --input-format" | "claude --json-schema" \
      | "claude --max-budget-usd" | "claude --mcp-config" | "claude --model" | "claude -n" \
      | "claude --name" | "claude --output-format" | "claude --permission-mode" \
      | "claude --permission-prompts" | "claude --plugin-dir" | "claude --plugin-url" \
      | "claude --prompt-suggestions" | "claude --remote-control" \
      | "claude --remote-control-session-name-prefix" \
      | "claude --setting-sources" | "claude --settings" | "claude --system-prompt" \
      | "claude --system-prompt-snapshot" | "claude --teleport" | "claude --tools" \
      | "claude -w" | "claude --worktree" \
      | "pi --provider" | "pi --model" | "pi --api-key" | "pi --system-prompt" \
      | "pi --append-system-prompt" | "pi --mode" | "pi --session-dir" | "pi --name" | "pi -n" \
      | "pi --models" | "pi --tools" | "pi -t" | "pi --exclude-tools" | "pi -xt" \
      | "pi --thinking" | "pi --extension" | "pi -e" | "pi --skill" | "pi --prompt-template" \
      | "pi --theme" | "pi --use-theme" | "pi --tui-mode")
      return 0 ;;
  esac
  return 1
}

# Run before exec: the watcher and the harness share this pid's life. Only a
# labelled desk gets a record, and headless runs have nothing to resume.
# Recorded args are what a resume can replay beside an explicit session: not a
# prompt, not "continue the latest", and not the session flag restore adds.
remember_desk() {
  local harness session="" issue="" space record tmp flags="[]" arg name
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/bercail/desk-sessions"
  local -a rest=()
  local saw_pos=0
  [[ -n "${HC_TERMINAL_ID:-}" ]] && command -v hc >/dev/null && command -v jq >/dev/null || return 0
  harness="$(basename "${argv[0]}")"
  set -- "${argv[@]:1}"
  while (($#)); do
    arg="$1"
    shift
    if [[ "$arg" == -- ]]; then
      [[ "$harness" == claude || "$harness" == pi ]] || rest+=("$arg" "$@")
      break
    fi
    if [[ "$arg" != -* ]]; then
      if [[ "$saw_pos" -eq 0 ]]; then
        saw_pos=1
        case "$harness $arg" in
          "opencode run" | "codex exec") return 0 ;;
        esac
      fi
      # Claude's and Pi's free positionals are their first messages, not resume options.
      [[ "$harness" != claude && "$harness" != pi ]] || continue
      rest+=("$arg")
      continue
    fi
    name="$arg"
    [[ "$arg" == *=* ]] && name="${arg%%=*}"
    case "$harness $name" in
      "claude -p" | "claude --print" | "cursor-agent -p" | "cursor-agent --print" | "pi -p" | "pi --print")
        return 0 ;;
      "opencode --session" | "opencode -s" | "pi --session" | "pi --session-id")
        if [[ "$arg" == *=* ]]; then
          session="${arg#*=}"
        else
          session="${1:-}"
          shift || true
        fi
        continue ;;
      "claude --resume" | "claude -r" | "claude --session-id")
        if [[ "$arg" == *=* ]]; then
          session="${arg#*=}"
        elif [[ -n "${1:-}" && "${1}" != -* ]]; then
          session="$1"
          shift
        fi
        continue ;;
      "opencode --prompt" | "pi --fork")
        [[ "$arg" == *=* ]] || shift || true
        continue ;;
      "opencode --continue" | "opencode -c" | "claude --continue" | "claude -c" | "claude --fork-session" \
        | "pi --continue" | "pi -c" | "pi --resume" | "pi -r")
        continue ;;
    esac
    if [[ "$arg" != *=* && -n "${1:-}" && "${1}" != -* ]] && flag_has_value "$harness" "$name"; then
      rest+=("$arg" "$1")
      shift
      continue
    fi
    rest+=("$arg")
  done
  space="$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null \
    | jq -r 'select(.labels["bercail.role"] == "agent") | .labels["bercail.space"] // empty')" || return 0
  [[ -n "$space" ]] || return 0
  [[ "$prompt" =~ beads\ issue\ ([A-Za-z0-9_-]+) ]] && issue="${BASH_REMATCH[1]}"
  # Private only when we create it. An existing dir keeps its mode, and this
  # does not change the process umask the harness inherits. Parents, if missing,
  # keep that umask too.
  if [[ ! -d "$dir" ]]; then
    mkdir -p "$(dirname "$dir")" || return 0
    mkdir -m 0700 "$dir" 2>/dev/null || [[ -d "$dir" ]] || return 0
  fi
  record="$dir/$HC_TERMINAL_ID.json"
  # A resume has no prompt: the issue stays what it was in this terminal.
  [[ -n "$issue" ]] || issue="$(jq -r '.issue // empty' "$record" 2>/dev/null)" || issue=""
  [[ ${#rest[@]} -eq 0 ]] || flags="$(jq -cn --args '$ARGS.positional' -- "${rest[@]}")"
  # 0600 in a subshell, so the harness keeps the umask it was started with.
  tmp="$(umask 077 && mktemp "$dir/.${HC_TERMINAL_ID}.json.XXXXXX")" || return 0
  if ! jq -n --arg address "$HC_TERMINAL_ID" --arg session "$session" --arg cwd "$PWD" \
    --arg harness "$harness" --arg issue "$issue" --arg space "$space" \
    --argjson pid "$$" --argjson args "$flags" \
    '{address: $address, session: $session, cwd: $cwd, harness: $harness,
      issue: $issue, space: $space, args: $args, pid: $pid}' >"$tmp" || ! mv "$tmp" "$record"; then
    rm -f "$tmp"
    return 0
  fi
  (set +e; watch_desk "$$" "$record") &
}

remember_desk || true

case "$(basename "${argv[0]}")" in
  codex)
    # hc runs codex without its app-server daemon.
    [[ " ${argv[*]} " == *" --no-daemon "* ]] || argv+=(--no-daemon)
    ;;
  opencode)
    [[ "$bstack" -eq 0 ]] || export OPENCODE_CLI_CONFIG_CONTENT="$CLI_CONFIG"
    # opencode's TUI reads a positional argument as a directory.
    [[ -z "$prompt" ]] || argv+=(--prompt "$prompt")
    prompt=""
    ;;
  pi)
    # First, so a `--` in the command cannot make it a message.
    if [[ -f "$PI_DESK_EXTENSION" && " ${argv[*]} " != *" $PI_DESK_EXTENSION "* ]]; then
      argv=("${argv[0]}" -e "$PI_DESK_EXTENSION" "${argv[@]:1}")
    fi
    # bstack reaches Claude through pi-claude-bridge on the plan, not an API key.
    [[ "$on_pi" -eq 0 ]] || unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
    ;;
esac
[[ -z "$prompt" ]] || argv+=("$prompt")

exec "${argv[@]}"
