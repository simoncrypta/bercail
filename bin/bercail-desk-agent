#!/usr/bin/env bash
# The desk agent. Usage: bercail-desk-agent [--prompt TEXT] [--model MODEL] [--role autopilot] [COMMAND [ARGS...]]
#
# COMMAND defaults to bstack's Pi lead: lead.json, which bercail update writes.
# --model runs that Pi command on MODEL (provider/id[:thinking]) and changes
# nothing else in it. --role autopilot runs it as bstack's autopilot.
set -euo pipefail

PI_LEAD="$HOME/.local/share/bercail/pi/lead.json"
# Every Pi desk loads it: it tells the record which session runs there.
PI_DESK_EXTENSION="$HOME/.local/share/bercail/pi-extensions/bercail-desk.ts"
# Beside this script once installed; a packaged bercail is on PATH.
BERCAIL="$(dirname "$0")/bercail"
[[ -x "$BERCAIL" ]] || BERCAIL=bercail

prompt=""
model=""
role=""
while [[ "${1:-}" == --prompt || "${1:-}" == --model || "${1:-}" == --role ]]; do
  case "$1" in
    --prompt) prompt="${2:-}" ;;
    --model) model="${2:-}" ;;
    --role) role="${2:-}" ;;
  esac
  shift 2 || shift $#
done

argv=("$@")
if [[ ${#argv[@]} -eq 0 ]]; then
  [[ -r "$PI_LEAD" ]] || {
    printf 'bercail-desk-agent: %s is missing; run bercail update\n' "$PI_LEAD" >&2
    exit 1
  }
  while IFS= read -r -d '' arg; do
    argv+=("$arg")
  done < <(jq -j '.[] | ., "\u0000"' "$PI_LEAD")
fi

# A newly dispatched visible desk has a pinned session before the native launch;
# a lost response cannot justify adopting a replacement session later.
if [[ -n "${WT_HERDR_SESSION_ID:-}" && "$(basename "${argv[0]}")" == pi ]]; then
  argv+=(--session-id "$WT_HERDR_SESSION_ID")
fi
unset WT_HERDR_SESSION_ID BERCAIL_TASK_RESERVED

# Swap only the model. Before the record: a restore replays its flags, so the
# desk comes back on this model.
if [[ -n "$model" ]]; then
  [[ "$(basename "${argv[0]}")" == pi ]] || {
    printf 'bercail-desk-agent: --model is for Pi, not %s\n' "${argv[0]}" >&2
    exit 1
  }
  swapped=0
  for ((i = 1; i < ${#argv[@]}; i++)); do
    case "${argv[i]}" in
      --) break ;;
      --model) argv[i + 1]="$model"; swapped=1; break ;;
      --model=*) argv[i]="--model=$model"; swapped=1; break ;;
    esac
  done
  [[ "$swapped" -eq 1 ]] || argv=("${argv[0]}" --model "$model" "${argv[@]:1}")
fi

[[ -z "$role" || ( "$role" == autopilot && "$(basename "${argv[0]}")" == pi ) ]] || {
  printf 'bercail-desk-agent: --role takes autopilot, on Pi; not %s on %s\n' "$role" "${argv[0]}" >&2
  exit 1
}

# An idle harness writes nothing. Heartbeat the record, using hc events to
# notice its exit without waiting a full minute. Session identity comes from
# the Pi desk extension, not hc's turn-only status reports.
# Once the harness is gone, its scratch folder and any a killed sibling left are
# swept. HUP and TERM are ignored so closing the terminal does not end the
# watcher first.
watch_desk() {
  local pid="$1" record="$2" events
  trap '' INT HUP TERM
  exec </dev/null >/dev/null 2>&1
  while kill -0 "$pid"; do
    exec 3< <(hc events --json --terminal "$HC_TERMINAL_ID")
    events=$!
    while kill -0 "$pid"; do
      touch -c "$record"
      if IFS= read -r -t 60 -u 3 _; then
        continue
      elif (($? <= 128)); then
        break
      fi
    done
    kill "$events"
    exec 3<&-
    kill -0 "$pid" && sleep 5
  done
  "$BERCAIL" scratch sweep
}

# 0 when FLAG takes the next argv word. An equals form already holds its value.
# Only listed flags do.
flag_has_value() {
  case "$1" in
    --provider | --model | --api-key | --system-prompt | --append-system-prompt | --mode \
      | --session-dir | --name | -n | --models | --tools | -t | --exclude-tools | -xt \
      | --thinking | --extension | -e | --skill | --prompt-template | --theme | --use-theme | --tui-mode)
      return 0 ;;
  esac
  return 1
}

# Run before exec: the watcher and the harness share this pid's life. Only a
# labelled desk gets a record, and headless runs have nothing to resume.
# Recorded args are what a resume can replay beside an explicit session: not a
# prompt, not "continue the latest", and not the session flag restore adds.
remember_desk() {
  local harness session="" issue="" issue_title="" space record tmp flags="[]" arg name hcjson=""
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/bercail/desk-sessions"
  local -a rest=()
  [[ -n "${HC_TERMINAL_ID:-}" ]] && command -v hc >/dev/null && command -v jq >/dev/null || return 0
  harness="$(basename "${argv[0]}")"
  # Only a Pi session can be resumed.
  [[ "$harness" == pi ]] || return 0
  set -- "${argv[@]:1}"
  while (($#)); do
    arg="$1"
    shift
    [[ "$arg" != -- ]] || break
    # Free positionals are Pi's first messages, not resume options.
    [[ "$arg" == -* ]] || continue
    name="$arg"
    [[ "$arg" == *=* ]] && name="${arg%%=*}"
    case "$name" in
      -p | --print)
        return 0 ;;
      --session | --session-id)
        if [[ "$arg" == *=* ]]; then
          session="${arg#*=}"
        else
          session="${1:-}"
          shift || true
        fi
        continue ;;
      --fork)
        [[ "$arg" == *=* ]] || shift || true
        continue ;;
      --continue | -c | --resume | -r)
        continue ;;
    esac
    if [[ "$arg" != *=* && -n "${1:-}" && "${1}" != -* ]] && flag_has_value "$name"; then
      rest+=("$arg" "$1")
      shift
      continue
    fi
    rest+=("$arg")
  done
  hcjson="$(hc get "$HC_TERMINAL_ID" --json 2>/dev/null)" || return 0
  space="$(jq -r 'select(.labels["bercail.role"] == "agent") | .labels["bercail.space"] // empty' <<<"$hcjson")" || return 0
  [[ -n "$space" ]] || return 0
  # A child id has dots (bercail-237.15); the period that ends the sentence is not in it.
  # In an Entire repo the job is a trail: "Your job is trail:12: ...", read first,
  # since its title may name a beads issue.
  if [[ "$prompt" =~ ^Your\ job\ is\ (trail:[1-9][0-9]*) ]]; then
    issue="${BASH_REMATCH[1]}"
  elif [[ "$prompt" =~ beads\ issue\ ([A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)*) ]]; then
    issue="${BASH_REMATCH[1]}"
  fi
  # Private only when we create it. An existing dir keeps its mode, and this
  # does not change the process umask the harness inherits. Parents, if missing,
  # keep that umask too.
  if [[ ! -d "$dir" ]]; then
    mkdir -p "$(dirname "$dir")" || return 0
    mkdir -m 0700 "$dir" 2>/dev/null || [[ -d "$dir" ]] || return 0
  fi
  record="$dir/$HC_TERMINAL_ID.json"
  # A resume has no prompt: the issue stays what it was in this terminal.
  [[ -n "$issue" ]] || issue="$(jq -r '.issue // empty' "$record" 2>/dev/null)" || issue=""
  # Label title when it names this issue; else the record's, on resume.
  if [[ -n "$issue" ]] && jq -e --arg issue "$issue" '.labels["bercail.issue"] == $issue' <<<"$hcjson" >/dev/null 2>&1; then
    issue_title="$(jq -r '.labels["bercail.issue_title"] // ""' <<<"$hcjson" 2>/dev/null)" || issue_title=""
  elif [[ -n "$issue" && -r "$record" ]]; then
    issue_title="$(jq -r --arg issue "$issue" 'if (.issue // "") == $issue then .issue_title // "" else "" end' "$record" 2>/dev/null)" || issue_title=""
  fi
  [[ ${#rest[@]} -eq 0 ]] || flags="$(jq -cn --args '$ARGS.positional' -- "${rest[@]}")"
  # 0600 in a subshell, so the harness keeps the umask it was started with.
  tmp="$(umask 077 && mktemp "$dir/.${HC_TERMINAL_ID}.json.XXXXXX")" || return 0
  if ! jq -n --arg address "$HC_TERMINAL_ID" --arg session "$session" --arg cwd "$PWD" \
    --arg harness "$harness" --arg issue "$issue" --arg issue_title "$issue_title" --arg space "$space" \
    --argjson pid "$$" --argjson args "$flags" \
    '{address: $address, session: $session, cwd: $cwd, harness: $harness,
      issue: $issue, issue_title: $issue_title, space: $space, args: $args, pid: $pid}' >"$tmp" || ! mv "$tmp" "$record"; then
    rm -f "$tmp"
    return 0
  fi
  (set +e; watch_desk "$$" "$record") &
  WATCHED=1
}

WATCHED=""
remember_desk || true

# The harness's own TMPDIR, named for this pid, which exec hands to it: only with
# a watcher to sweep it. The sweep of runs that ended unwatched, and of old /tmp
# entries, does not hold up the start. It starts first: with the folder as its
# TMPDIR it would hold it, and the watcher could not remove it after a short run.
if [[ -n "$WATCHED" ]] && scratch="$("$BERCAIL" scratch dir "$$" 2>/dev/null)"; then
  ("$BERCAIL" scratch sweep >/dev/null 2>&1 &)
  export TMPDIR="$scratch"
fi

# An autopilot desk: the guard lets it commit and push its PR branch, and its
# prompt says to drive that PR to green. After the record, so a restore brings
# the desk back as a plain lead, which has neither.
if [[ -n "$role" ]]; then
  export BERCAIL_ROLE=autopilot
  argv=("${argv[0]}" --append-system-prompt "$(dirname "$PI_LEAD")/agents/bstack-autopilot.md" "${argv[@]:1}")
fi

if [[ "$(basename "${argv[0]}")" == pi ]]; then
  # First, so a `--` in the command cannot make it a message.
  if [[ -f "$PI_DESK_EXTENSION" && " ${argv[*]} " != *" $PI_DESK_EXTENSION "* ]]; then
    argv=("${argv[0]}" -e "$PI_DESK_EXTENSION" "${argv[@]:1}")
  fi
  # bstack reaches Claude through pi-claude-bridge on the plan, not an API key.
  unset ANTHROPIC_API_KEY ANTHROPIC_BASE_URL ANTHROPIC_AUTH_TOKEN
fi
[[ -z "$prompt" ]] || argv+=("$prompt")

exec "${argv[@]}"
