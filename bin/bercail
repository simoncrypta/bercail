#!/usr/bin/env bash
set -euo pipefail

# Real directory of this script. mise and packslip put a symlink on PATH that
# points into the unpacked release, so follow links before looking for ../lib.
bercail_bin_dir() {
  local src="${BASH_SOURCE[0]}" dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  cd -P "$(dirname "$src")" && pwd
}

# A release archive (mise packslip: backend or packslip install) carries this
# marker. That package manager owns the bercail command, so the installer must
# not copy another one into ~/.local/bin.
bercail_mark_packaged() {
  local root
  root="$(cd "$(bercail_bin_dir)/.." && pwd)"
  if [[ -f "$root/.bercail-package" ]]; then
    export BERCAIL_PACKAGED=1
  fi
}

find_lib_dir() {
  local bin dir="${BERCAIL_LIB:-}"
  if [[ -n "$dir" && -d "$dir" ]]; then
    printf '%s' "$dir"
    return 0
  fi
  bin="$(bercail_bin_dir)"
  if [[ -f "$bin/../lib/common.sh" ]]; then
    printf '%s' "$(cd "$bin/../lib" && pwd)"
    return 0
  fi
  dir="${HOME}/.local/share/bercail/lib"
  [[ -d "$dir" ]] || return 1
  printf '%s' "$dir"
}

load_libs() {
  local lib
  lib="$(find_lib_dir)" || {
    printf 'error: cannot find bercail lib (re-run install.sh)\n' >&2
    exit 1
  }
  # shellcheck source=/dev/null
  source "$lib/common.sh"
  # shellcheck source=/dev/null
  source "$lib/detect.sh"
  # shellcheck source=/dev/null
  source "$lib/deps.sh"
  # shellcheck source=/dev/null
  source "$lib/config.sh"
  # shellcheck source=/dev/null
  source "$lib/skills.sh"
  # shellcheck source=/dev/null
  source "$lib/shell-rc.sh"
  # shellcheck source=/dev/null
  source "$lib/uninstall.sh"
  # shellcheck source=/dev/null
  source "$lib/help.sh"
  # shellcheck source=/dev/null
  source "$lib/omarchy.sh"
  # shellcheck source=/dev/null
  source "$lib/notify.sh"
  # shellcheck source=/dev/null
  source "$lib/doctor.sh"
  # shellcheck source=/dev/null
  source "$lib/bstack.sh"
  # shellcheck source=/dev/null
  source "$lib/desk.sh"
  # shellcheck source=/dev/null
  source "$lib/shep.sh"
}

cmd_doctor() {
  local failures=0 shell_rc
  log "bercail doctor (v${BERCAIL_VERSION})"
  log ""
  log "Platform: $(detect_platform)"
  log ""
  log "Dependencies:"
  doctor_dependencies || failures=1
  log ""
  log "Integration:"
  shell_rc="$(shell_rc_for "$(detect_shell_name)")"
  if has_marker_block "$shell_rc"; then
    log "  ok  marker block in $shell_rc"
  else
    log "  missing  marker block in $shell_rc"
    failures=1
  fi
  if [[ -f "$BERCAIL_USER_CONFIG" ]]; then
    log "  ok  $BERCAIL_USER_CONFIG (review=$(read_layout_review))"
    doctor_config
  else
    log "  missing  $BERCAIL_USER_CONFIG"
    failures=1
  fi
  doctor_helper || failures=1
  doctor_herdr_app || failures=1
  doctor_herdr_app_update
  doctor_mod_copies
  doctor_skill || failures=1
  doctor_omarchy_integration || failures=1
  doctor_notify || failures=1
  doctor_bstack || failures=1
  doctor_desk_restore || failures=1
  return "$failures"
}

# Full install from the tree this command was unpacked from (mise or packslip).
# The curl installer stays the other way in; it does not need this command.
cmd_install() {
  local root
  root="$(cd "$(bercail_bin_dir)/.." && pwd)"
  if [[ ! -f "$root/install.sh" || ! -f "$root/lib/common.sh" ]]; then
    printf 'error: no install.sh beside this bercail (%s)\n' "$root" >&2
    printf 'install with: curl -fsSL https://bercail.dev/install.sh | bash\n' >&2
    exit 1
  fi
  exec bash "$root/install.sh" "$@"
}

cmd_update() {
  deploy_configs
  deploy_omarchy_integration
  install_shell_integration || true
  notify_restart_follower
  show_summary
}

cmd_reconfigure() {
  # shellcheck disable=SC2034 # read by lib/omarchy.sh
  RECONFIGURE=1
  prompt_user_config
  deploy_skills
  ensure_pi
  ensure_tuicr
  deploy_bstack
  sync_omarchy_default_agent
  info "the desk runs bstack's Pi lead  review=$(read_layout_review)"
}

# The release this one replaces restarted its update here (restart_update, in
# lib/config.sh) after copying lib/ by its own list. Fetch what this release
# added before load_libs reads it.
complete_lib() {
  local lib
  lib="$(find_lib_dir)" || return 0
  # shellcheck source=/dev/null
  source "$lib/common.sh"
  # shellcheck source=/dev/null
  source "$lib/config.sh"
  deploy_lib
}

main() {
  local cmd="${1:-help}"
  shift || true
  bercail_mark_packaged

  case "$cmd" in
    install)
      cmd_install "$@"
      ;;
    help|-h|--help)
      load_libs
      show_help
      ;;
    doctor)
      load_libs
      cmd_doctor
      ;;
    bstack)
      load_libs
      cmd_bstack "$@"
      ;;
    desk)
      load_libs
      cmd_desk "$@"
      ;;
    notify)
      load_libs
      cmd_notify "$@"
      ;;
    shep)
      load_libs
      # Shep's compaction extension runs this bercail's board.
      BERCAIL_SELF="$(bercail_bin_dir)/bercail"
      export BERCAIL_SELF
      cmd_shep "$@"
      ;;
    config)
      load_libs
      cmd_config "$@"
      ;;
    policy)
      load_libs
      # shellcheck source=/dev/null
      source "$(find_lib_dir)/policy.sh"
      cmd_policy "$@"
      ;;
    review-pr)
      load_libs
      # shellcheck source=/dev/null
      source "$(find_lib_dir)/review.sh"
      BERCAIL_SELF="$(bercail_bin_dir)/bercail"
      export BERCAIL_SELF
      cmd_review_pr "$@"
      ;;
    update)
      [[ -z "${BERCAIL_UPDATE_RESTARTED:-}" ]] || complete_lib
      load_libs
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --force|-f)
            # shellcheck disable=SC2034 # read by lib/config.sh and lib/shell-rc.sh
            FORCE=1
            shift
            ;;
          *) die "unknown option: $1" ;;
        esac
      done
      cmd_update
      ;;
    reconfigure)
      load_libs
      cmd_reconfigure
      ;;
    dry-run)
      load_libs
      # shellcheck disable=SC2034 # both read by lib/common.sh
      DRY_RUN=1 YES=1
      install_dependencies
      deploy_configs
      deploy_omarchy_integration
      install_shell_integration || true
      ;;
    uninstall)
      load_libs
      uninstall_bercail
      ;;
    *)
      load_libs
      help_commands >&2
      printf "\nRun 'bercail help' for the shell commands, keys, and files.\n" >&2
      exit 1
      ;;
  esac
}

main "$@"
