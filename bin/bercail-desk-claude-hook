#!/usr/bin/env bash
# Claude Code SessionStart hook: writes the session id into this terminal's desk
# record (see bercail-desk-agent), so `bercail desk restore` can resume it. Runs
# on every session start, so it leaves anything but the desk's own Claude alone:
# no record means not a desk, and a `claude -p` the desk agent started is not
# the process the record names. It must never get in Claude's way.
umask 077
record="${XDG_STATE_HOME:-$HOME/.local/state}/bercail/desk-sessions/${HC_TERMINAL_ID:-none}.json"
[[ -f "$record" ]] || exit 0
pid="$(jq -r 'select(.harness == "claude") | .pid' "$record" 2>/dev/null)"
[[ -n "$pid" ]] || exit 0
# A shell-form hook has one shell between us and Claude. A nested `claude -p`
# may also be its child, so ancestry alone is not enough.
if [[ "$PPID" != "$pid" ]]; then
  case "$(ps -o comm= -p "$PPID" 2>/dev/null)" in
    bash | sh | dash | zsh)
      [[ "$(ps -o ppid= -p "$PPID" 2>/dev/null | tr -d ' ')" == "$pid" ]] || exit 0 ;;
    *) exit 0 ;;
  esac
fi
session="$(jq -r '.session_id // empty' 2>/dev/null)"
[[ -n "$session" ]] || exit 0
jq --arg id "$session" '.session = $id' "$record" >"$record.tmp.$$" 2>/dev/null \
  && mv "$record.tmp.$$" "$record"
exit 0
