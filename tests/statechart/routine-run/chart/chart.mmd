stateDiagram-v2
  state "Legend" as legend {
    lg0: rest
    lg1: paused
  }
  class lg0 blue
  class lg1 pink
  s0: Scheduled
  s1: Due
  s2: Paused
  s3: Running
  s4: Skipped
  s5: Failed
  s6: Sending
  s7: Emitted
  [*] --> s0
  s0 --> s1: it comes due
  s0 --> s2: you pause it
  s2 --> s0: you resume it
  s2 --> s1: it comes due
  s1 --> s3: takes its locks
  s1 --> s4: no free slot or it is paused
  s3 --> s5: fails or times out
  s3 --> s4: nothing new
  s4 --> s6: run logged
  s5 --> s6: run logged or 3rd failure
  s3 --> s7: new findings
  s6 --> s0: outbox sent
  s6 --> s2: outbox sent
  s7 --> s6: event in outbox
  class s0 blue
  class s2 pink
