# Copy to ~/.config/bercail/notify.d/<name>.toml, one file per bot.
# chmod 600 it if it holds `key`; notify.sh refuses group/other-readable keys.
# Flat `key = value` only. Lists are comma separated. Quotes are optional.

url = "https://example.invalid/your/webhook"
key = "paste-the-automation-key"   # or: key_file = ~/.config/bercail/work-shep.key (chmod 600)
auth = both                        # both | bearer | x-automation-key | none

# Which workspaces. Empty workspaces and repos means every workspace.
# workspaces: Herdr workspace label globs, case-insensitive.
# repos: worktree repo_name globs (handoff desks keep the main repo's name).
workspaces = "Work, *_Leftlane_app"
repos = leftlane_app

panes = agent                      # agent (default) | any
notify = finished, blocked         # kinds to send
enabled = true
timeout = 8                        # seconds per POST (one retry on 000/5xx)
