[agent]
# Intended sticky agent is cursor-agent (handoff children always are).
command = "cursor-agent"

[layout]
review = "tuicr"
# Open tuicr when the layout agent pane goes done (branch vs origin/main
# plus uncommitted, watching). Someone else's PR uses `tuicr pr`.
# Set false to disable the hook.
auto_review = true
# Omit editor to use $EDITOR / $VISUAL, or nano/vi on macOS.
# editor = "nvim"
agent_ratio = 0.416667
sidebar_ratio = 0.166667

[files]
show_dotfiles = false
follow_cwd = true
