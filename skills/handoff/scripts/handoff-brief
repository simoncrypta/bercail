#!/usr/bin/env bash
# Intake is not a stage. Write one job brief before any harness runs.
# shellcheck shell=bash
set -euo pipefail

_HANDOFF_BRIEF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=handoff-stages.sh
source "$_HANDOFF_BRIEF_DIR/handoff-stages.sh"

handoff_brief_usage() {
  cat >&2 <<'USAGE'
usage: handoff-brief --source linear|ask|note --worktree PATH --repo URL-or-path
                     (--ask-file PATH | stdin)
                     [--link URL]...

Writes <worktree>/.bercail/job-brief.json with ask, repo, links, source.
A Linear issue, a direct ask, and a note are the same file. This does not
start claude, cursor-agent, or a Herdr pane. Do not pass the ask on argv.
USAGE
  exit 2
}

handoff_brief_main() {
  local source="" worktree="" repo="" ask_file="" ask=""
  local -a links=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) handoff_brief_usage ;;
      --source)
        [[ $# -ge 2 ]] || handoff_brief_usage
        source="$2"
        shift 2
        ;;
      --worktree)
        [[ $# -ge 2 ]] || handoff_brief_usage
        worktree="$2"
        shift 2
        ;;
      --repo)
        [[ $# -ge 2 ]] || handoff_brief_usage
        repo="$2"
        shift 2
        ;;
      --ask-file)
        [[ $# -ge 2 ]] || handoff_brief_usage
        ask_file="$2"
        shift 2
        ;;
      --link)
        [[ $# -ge 2 ]] || handoff_brief_usage
        links+=("$2")
        shift 2
        ;;
      --) handoff_die "do not pass the ask after --; use --ask-file or stdin" ;;
      -*) handoff_brief_usage ;;
      *) handoff_die "do not pass the ask on argv; use --ask-file or stdin" ;;
    esac
  done

  case "$source" in
    linear|ask|note) ;;
    *) handoff_die "source must be linear, ask, or note" ;;
  esac
  [[ -n "$worktree" && -d "$worktree" ]] || handoff_die "worktree directory is required"
  [[ -n "$repo" ]] || handoff_die "repo is required (url or path)"
  command -v jq >/dev/null 2>&1 || handoff_die "jq is required"

  if [[ -n "$ask_file" ]]; then
    [[ -f "$ask_file" ]] || handoff_die "ask file not found: $ask_file"
    ask="$(cat -- "$ask_file")"
  elif [[ -t 0 ]]; then
    handoff_die "empty ask (use --ask-file or stdin; do not pass the ask on argv)"
  else
    ask="$(cat)"
  fi
  [[ -n "$ask" ]] || handoff_die "empty ask"

  worktree="$(handoff_abspath "$worktree")"
  local dest
  dest="$(handoff_brief_path "$worktree")"
  handoff_write_brief "$dest" "$ask" "$repo" "$source" "${links[@]}"
  handoff_brief_ok "$dest" || handoff_die "wrote an invalid brief: $dest"
  jq -nc --arg path "$dest" --arg source "$source" '{ok:true,brief:$path,source:$source}'
  printf '\n'
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  handoff_brief_main "$@"
fi
