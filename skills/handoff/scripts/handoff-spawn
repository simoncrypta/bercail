#!/usr/bin/env bash
# One-command Herdr handoff: worktree + dirty copy + layout + cursor-agent prompt.
# shellcheck shell=bash
set -euo pipefail

handoff_die() {
  printf 'handoff-spawn: %s\n' "$*" >&2
  exit 1
}

handoff_usage() {
  cat >&2 <<'EOF'
usage: handoff-spawn --info
       handoff-spawn --stash-prompt
       handoff-spawn --branch <name> [--dirty|--clean] [--plan] [--workspace <id>]
                     [--take-pending|--prompt-file <path>]

  --info          print JSON facts and exit
  --stash-prompt  write stdin to the pending prompt file; print its path as JSON
  --branch NAME   feature branch (required to spawn; do not pass the prompt on argv)
  --dirty         copy uncommitted main changes into the sibling as a working tree
                  (default when main is dirty)
  --clean         HEAD only; leave uncommitted files on main
  --plan          add "Plan/design only; do not implement yet."
  --workspace ID  parent Herdr workspace to keep focused (required when HERDR_ENV
                  is unset but the Herdr socket works)
  --take-pending  read and consume the pending prompt file from --info
  --prompt-file   read the original user prompt from a file

A positional branch is still accepted. Do not put the user prompt on argv
(no `-- prompt`). Grok Bot / Auto-review parents: write the pending file, then
run this script directly with flags and an explicit working directory.
EOF
  exit 2
}

handoff_realpath() {
  local path="$1"
  (cd "$path" 2>/dev/null && pwd -P) || printf '%s' "$path"
}

handoff_git_main() {
  git -C "$1" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree / { print substr($0, 10); exit }'
}

handoff_is_main_checkout() {
  local cwd main
  cwd="$(handoff_realpath "$1")"
  main="$(handoff_git_main "$1")"
  [[ -n "$main" ]] || return 1
  [[ "$cwd" == "$(handoff_realpath "$main")" ]]
}

handoff_main_is_dirty() {
  [[ -n "$(git -C "$1" status --porcelain --untracked-files=all 2>/dev/null)" ]]
}

handoff_graphite_config() {
  local root="$1" cfg
  cfg="$(git -C "$root" rev-parse --git-path .graphite_repo_config 2>/dev/null)" || return 1
  [[ -n "$cfg" ]] || return 1
  [[ "$cfg" == /* ]] || cfg="$root/$cfg"
  [[ -f "$cfg" ]] || return 1
  printf '%s' "$cfg"
}

handoff_is_graphite() {
  handoff_graphite_config "$1" >/dev/null
}

# Cursor pstack (/poteto-mode). Same glob as lib/deps.sh pstack_plugin_present.
handoff_has_pstack() {
  local cursor="${CURSOR_CONFIG_DIR:-$HOME/.cursor}" match
  shopt -s nullglob
  for match in \
    "$cursor/plugins/cache/cursor-public/pstack/"*/skills/poteto-mode/SKILL.md \
    "$cursor/plugins/local/pstack/skills/poteto-mode/SKILL.md"
  do
    if [[ -f "$match" ]]; then
      shopt -u nullglob
      return 0
    fi
  done
  shopt -u nullglob
  return 1
}

# Copy main's uncommitted tracked+untracked files into sibling as a working
# tree. Never git-add. After this: git diff --cached is empty; git diff HEAD
# matches main's dirty tracked files; untracked files exist on disk only.
handoff_copy_dirty() {
  local main="$1" sibling="$2" patch rel dest
  [[ -d "$main" && -d "$sibling" ]] || return 1
  patch="$(mktemp)"
  git -C "$main" diff HEAD --binary >"$patch" || true
  if [[ -s "$patch" ]]; then
    git -C "$sibling" apply --whitespace=nowarn "$patch" \
      || handoff_die "git apply of dirty working tree failed"
  fi
  rm -f "$patch"
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    dest="$sibling/$rel"
    mkdir -p "$(dirname "$dest")"
    cp -a "$main/$rel" "$dest"
  done < <(git -C "$main" ls-files --others --exclude-standard)
}

handoff_track_graphite() {
  local sibling="$1" cfg trunk
  cfg="$(handoff_graphite_config "$sibling")" || return 0
  command -v gt >/dev/null 2>&1 || return 0
  if gt --cwd "$sibling" parent >/dev/null 2>&1; then
    return 0
  fi
  trunk="$(jq -r '.trunk // "main"' "$cfg" 2>/dev/null || true)"
  trunk="${trunk:-main}"
  gt --cwd "$sibling" track --parent "$trunk" --no-interactive \
    || gt --cwd "$sibling" track --force --no-interactive \
    || handoff_die "gt track failed for $sibling"
}

handoff_sibling_path() {
  local main="$1" branch="$2" path
  path="$(git -C "$main" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
    /^worktree / { p = substr($0, 10) }
    /^branch / && $2 == b { print p; exit }
  ')"
  if [[ -n "$path" && -d "$path" ]]; then
    printf '%s' "$path"
    return 0
  fi
  path="${main}.${branch}"
  [[ -d "$path" ]] || return 1
  printf '%s' "$path"
}

handoff_one_line() {
  printf '%s' "$1" | tr '\n' ' ' | sed 's/  */ /g; s/^ //; s/ $//'
}

handoff_state_dir() {
  printf '%s/agentic-dev' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

handoff_pending_prompt_path() {
  printf '%s/pending-prompt.txt' "$(handoff_state_dir)"
}

handoff_stash_prompt() {
  local file text
  command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
  mkdir -p "$(handoff_state_dir)"
  file="$(handoff_pending_prompt_path)"
  text="$(cat)"
  [[ -n "$text" ]] || handoff_die "empty prompt on stdin"
  printf '%s' "$text" >"$file"
  jq -nc --arg path "$file" '{ok:true,pending_prompt:$path}'
  printf '\n'
}

handoff_remember() {
  local dir file
  dir="$(handoff_state_dir)"
  mkdir -p "$dir"
  file="$dir/handoffs.jsonl"
  printf '%s\n' "$1" >>"$file"
}

handoff_prompt_text() {
  local body="$1"
  if [[ "$body" == /poteto-mode* ]]; then
    printf '%s' "$body"
    return 0
  fi
  printf '/poteto-mode\n\n%s' "$body"
}

handoff_herdr_bin() {
  printf '%s' "${HERDR_BIN_PATH:-herdr}"
}

handoff_herdr_socket_ok() {
  "$(handoff_herdr_bin)" workspace list >/dev/null 2>&1
}

handoff_parent_workspace() {
  local ws="${HANDOFF_WORKSPACE:-${HERDR_WORKSPACE_ID:-}}"
  [[ -n "$ws" ]] || return 1
  printf '%s' "$ws"
}

handoff_bool_json() {
  if [[ "$1" -eq 1 ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

handoff_result_json() {
  local label="$1" sibling="$2" branch="$3" prompt="$4" started="$5" copied="$6" graphite="$7"
  jq -nc \
    --arg label "$label" \
    --arg path "$sibling" \
    --arg branch "$branch" \
    --arg task "$(handoff_one_line "$prompt")" \
    --argjson agent_started "$(handoff_bool_json "$started")" \
    --argjson dirty_copied "$(handoff_bool_json "$copied")" \
    --argjson graphite "$(handoff_bool_json "$graphite")" \
    '{ok:true,label:$label,path:$path,branch:$branch,task:$task,agent_started:$agent_started,dirty_copied:$dirty_copied,graphite:$graphite}'
}

handoff_info_json() {
  local cwd branch helper default_copy pending
  local herdr_env=0 socket=0 herdr=0 main_ok=0 dirty=0 graphite=0 pstack=0 helper_present=0 pending_present=0
  cwd="$(handoff_realpath "$PWD")"
  [[ "${HERDR_ENV:-}" == 1 ]] && herdr_env=1
  if handoff_herdr_socket_ok; then
    socket=1
  fi
  if [[ "$herdr_env" -eq 1 || "$socket" -eq 1 ]]; then
    herdr=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_is_main_checkout "$cwd"; then
    main_ok=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_main_is_dirty "$cwd"; then
    dirty=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_is_graphite "$cwd"; then
    graphite=1
  fi
  if handoff_has_pstack; then
    pstack=1
  fi
  branch="$(git -C "$cwd" branch --show-current 2>/dev/null || true)"
  helper="${HOME}/.config/worktrunk/herdr-layout.sh"
  [[ -f "$helper" ]] && helper_present=1
  if [[ "$dirty" -eq 1 ]]; then
    default_copy="dirty"
  else
    default_copy="clean"
  fi
  pending="$(handoff_pending_prompt_path)"
  pending_present=0
  [[ -s "$pending" ]] && pending_present=1
  jq -nc \
    --arg cwd "$cwd" \
    --arg branch "$branch" \
    --arg default_copy "$default_copy" \
    --arg helper "$helper" \
    --arg workspace "${HANDOFF_WORKSPACE:-${HERDR_WORKSPACE_ID:-}}" \
    --arg pending_prompt "$pending" \
    --argjson herdr "$(handoff_bool_json "$herdr")" \
    --argjson herdr_env "$(handoff_bool_json "$herdr_env")" \
    --argjson socket "$(handoff_bool_json "$socket")" \
    --argjson main_checkout "$(handoff_bool_json "$main_ok")" \
    --argjson dirty "$(handoff_bool_json "$dirty")" \
    --argjson graphite "$(handoff_bool_json "$graphite")" \
    --argjson pstack "$(handoff_bool_json "$pstack")" \
    --argjson helper_present "$(handoff_bool_json "$helper_present")" \
    --argjson pending_prompt_present "$(handoff_bool_json "$pending_present")" \
    '{
      herdr:$herdr,
      herdr_env:$herdr_env,
      socket:$socket,
      main_checkout:$main_checkout,
      cwd:$cwd,
      branch:$branch,
      dirty:$dirty,
      graphite:$graphite,
      pstack:$pstack,
      default_copy:$default_copy,
      helper:$helper,
      helper_present:$helper_present,
      workspace:$workspace,
      pending_prompt:$pending_prompt,
      pending_prompt_present:$pending_prompt_present
    }'
}

handoff_spawn_main() {
  local branch="" dirty="auto" plan=0 prompt="" prompt_file="" main sibling label intro graphite=0 copied=0
  local helper="$HOME/.config/worktrunk/herdr-layout.sh"
  local json parent_ws file body info=0 started=0 stash=0 take_pending=0 pending

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) handoff_usage ;;
      --info) info=1; shift ;;
      --stash-prompt) stash=1; shift ;;
      --take-pending) take_pending=1; shift ;;
      --dirty) dirty=1; shift ;;
      --clean) dirty=0; shift ;;
      --plan) plan=1; shift ;;
      --branch)
        [[ $# -ge 2 ]] || handoff_usage
        branch="$2"
        shift 2
        ;;
      --workspace)
        [[ $# -ge 2 ]] || handoff_usage
        HANDOFF_WORKSPACE="$2"
        shift 2
        ;;
      --prompt-file)
        [[ $# -ge 2 ]] || handoff_usage
        prompt_file="$2"
        shift 2
        ;;
      --)
        handoff_die "do not pass the prompt after --; write the pending file or use --prompt-file / stdin"
        ;;
      -*) handoff_usage ;;
      *)
        if [[ -z "$branch" ]]; then
          branch="$1"
          shift
        else
          break
        fi
        ;;
    esac
  done

  if [[ "$info" -eq 1 ]]; then
    command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
    handoff_info_json
    printf '\n'
    return 0
  fi

  if [[ "$stash" -eq 1 ]]; then
    handoff_stash_prompt
    return 0
  fi

  [[ -n "$branch" ]] || handoff_usage
  if [[ "$take_pending" -eq 1 ]]; then
    pending="$(handoff_pending_prompt_path)"
    [[ -f "$pending" ]] || handoff_die "no pending prompt at $pending (write that file, or --stash-prompt)"
    prompt="$(cat -- "$pending")"
    rm -f "$pending"
  elif [[ -n "$prompt_file" ]]; then
    [[ -f "$prompt_file" ]] || handoff_die "prompt file not found: $prompt_file"
    prompt="$(cat -- "$prompt_file")"
  elif [[ $# -gt 0 ]]; then
    prompt="$*"
  elif [[ -t 0 ]]; then
    handoff_die "empty prompt (Grok Bot: write pending_prompt from --info, then --take-pending; or --stash-prompt on stdin)"
  else
    prompt="$(cat)"
  fi
  [[ -n "$prompt" ]] || handoff_die "empty prompt (write pending_prompt, --prompt-file, or stdin)"

  command -v git >/dev/null 2>&1 || handoff_die "git is required"
  command -v wt >/dev/null 2>&1 || handoff_die "wt (worktrunk) is required"
  command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
  [[ -f "$helper" ]] || handoff_die "missing $helper"

  if [[ "${HERDR_ENV:-}" == 1 ]]; then
    parent_ws="$(handoff_parent_workspace || true)"
  elif handoff_herdr_socket_ok; then
    parent_ws="$(handoff_parent_workspace)" \
      || handoff_die "not inside a Herdr pane; pass --workspace <id> (HERDR_ENV is unset)"
  else
    handoff_die "cannot reach Herdr (HERDR_ENV unset and herdr workspace list failed)"
  fi

  main="$(handoff_realpath "$PWD")"
  handoff_is_main_checkout "$main" \
    || handoff_die "cwd is not the main git checkout; refuse to spawn from a linked worktree"

  if [[ "$dirty" == "auto" ]]; then
    if handoff_main_is_dirty "$main"; then
      dirty=1
    else
      dirty=0
    fi
  fi

  # shellcheck disable=SC1090
  source "$helper"

  if [[ -n "$parent_ws" ]]; then
    export WT_HERDR_KEEP_FOCUS="$parent_ws"
  fi
  wt switch --create "$branch" --no-cd \
    || handoff_die "wt switch --create $branch failed"
  _wt_herdr_keep_user_focus "$parent_ws"
  sibling="$(handoff_sibling_path "$main" "$branch")" \
    || handoff_die "could not resolve sibling worktree for $branch"
  sibling="$(handoff_realpath "$sibling")"

  if [[ "$dirty" == 1 ]]; then
    if handoff_main_is_dirty "$main"; then
      handoff_copy_dirty "$main" "$sibling"
      copied=1
    fi
  fi

  if handoff_is_graphite "$sibling"; then
    graphite=1
    handoff_track_graphite "$sibling"
  fi

  label="$(_wt_generate_session_name "$sibling")"

  intro="$(printf 'You are in linked worktree %s (branch %s). Stay in this checkout. Do not open Review or invoke the review skill; hunk opens itself when you go idle. Layout plugin id is agentic-dev.layout — never agentic-dev.dev-layout.' \
    "$sibling" "$branch")"
  if [[ "$plan" -eq 1 ]]; then
    intro="$(printf '%s\nPlan/design only; do not implement yet.' "$intro")"
  fi
  if [[ "$graphite" -eq 1 ]]; then
    intro="$(printf '%s\nUse gt, not raw git commit/push, unless asked.' "$intro")"
  fi

  mkdir -p "$(handoff_state_dir)"
  file="$(handoff_state_dir)/handoff-prompt-${branch}.txt"
  body="$(printf '%s\n\n%s' "$intro" "$prompt")"
  printf '%s' "$(handoff_prompt_text "$body")" >"$file"

  if ! handoff_has_pstack; then
    echo "handoff-spawn: pstack not found under ${CURSOR_CONFIG_DIR:-$HOME/.cursor}; install in Cursor with /add-plugin pstack. Child still starts as cursor-agent with /poteto-mode." >&2
  fi

  if WT_HERDR_KEEP_FOCUS="$parent_ws" \
    WT_HERDR_AGENT_CMD=cursor-agent \
    WT_HERDR_AGENT_PROMPT_FILE="$file" \
    wt_herdr_start_agent "$label" "$sibling"; then
    started=1
  else
    echo "handoff-spawn: start-agent did not confirm a live agent; worktree is still $sibling ($label)" >&2
  fi

  json="$(handoff_result_json "$label" "$sibling" "$branch" "$prompt" "$started" "$copied" "$graphite")"
  handoff_remember "$json"
  printf '%s\n' "$json"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  handoff_spawn_main "$@"
fi
