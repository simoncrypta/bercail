#!/usr/bin/env bash
# Handoff router: a named stage picks binary, headless vs sticky pane, model, worktree.
# The job is a beads issue; the agent prompt is only its id.
# shellcheck shell=bash
set -euo pipefail

handoff_die() {
  printf 'handoff-spawn: %s\n' "$*" >&2
  exit 1
}

_HANDOFF_SPAWN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=handoff-stages.sh
source "$_HANDOFF_SPAWN_DIR/handoff-stages.sh"

handoff_usage() {
  cat >&2 <<'EOF'
usage: handoff-spawn --info
       handoff-spawn --stage start|codex|cursor --issue ID --worktree PATH
                     [--binary claude|codex|cursor-agent] [--resume SESSION] [--dry-run]
       handoff-spawn --branch <name> --stage start|codex|cursor --issue ID
                     [--dirty|--clean] [--workspace <id>]

  --info          print JSON facts and exit
  --issue ID      beads issue to work (bd show ID). It holds the detail. The
                  agent's whole prompt is the id, for every harness.
  --stage NAME    required; named stage (see handoff-stages.sh). start is claude,
                  codex is Codex CLI, cursor is cursor-agent. Without --branch the
                  stage runs headless (same result file). With --branch it opens a
                  sticky pane running that stage's binary. Bercail has no default.
  --binary NAME   headless only: claude, codex, or cursor-agent. Overrides the
                  stage table binary. Bercail never switches it for you.
  --worktree PATH checkout for a headless stage (default: cwd)
  --resume ID     re-handoff: claude --resume, cursor-agent --resume, or
                  codex exec resume (no kill)
  --dry-run       print the headless command as JSON; no run, no issue check, no comment
  --branch NAME   feature branch for a sticky pane (any stage)
  --dirty         copy uncommitted main changes into the sibling as a working tree
                  (default when main is dirty)
  --clean         HEAD only; leave uncommitted files on main
  --workspace ID  parent Herdr workspace to keep focused (required when HERDR_ENV
                  is unset but the Herdr socket works)

Shep writes the beads issue first and owns the workflow. There are no prompt
files and no per-harness modes. Each real handoff adds a bd comment to the
issue with the worktree (and, headless, the result file).
EOF
  exit 2
}

handoff_realpath() {
  local path="$1"
  (cd "$path" 2>/dev/null && pwd -P) || printf '%s' "$path"
}

handoff_git_main() {
  git -C "$1" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree / { print substr($0, 10); exit }'
}

handoff_is_main_checkout() {
  local cwd main
  cwd="$(handoff_realpath "$1")"
  main="$(handoff_git_main "$1")"
  [[ -n "$main" ]] || return 1
  [[ "$cwd" == "$(handoff_realpath "$main")" ]]
}

handoff_main_is_dirty() {
  [[ -n "$(git -C "$1" status --porcelain --untracked-files=all 2>/dev/null)" ]]
}

handoff_graphite_config() {
  local root="$1" cfg
  cfg="$(git -C "$root" rev-parse --git-path .graphite_repo_config 2>/dev/null)" || return 1
  [[ -n "$cfg" ]] || return 1
  [[ "$cfg" == /* ]] || cfg="$root/$cfg"
  [[ -f "$cfg" ]] || return 1
  printf '%s' "$cfg"
}

handoff_is_graphite() {
  handoff_graphite_config "$1" >/dev/null
}

# Copy main's uncommitted tracked+untracked files into sibling as a working
# tree. Never git-add. After this: git diff --cached is empty; git diff HEAD
# matches main's dirty tracked files; untracked files exist on disk only.
handoff_copy_dirty() {
  local main="$1" sibling="$2" patch rel dest
  [[ -d "$main" && -d "$sibling" ]] || return 1
  patch="$(mktemp)"
  git -C "$main" diff HEAD --binary >"$patch" || true
  if [[ -s "$patch" ]]; then
    git -C "$sibling" apply --whitespace=nowarn "$patch" \
      || handoff_die "git apply of dirty working tree failed"
  fi
  rm -f "$patch"
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    dest="$sibling/$rel"
    mkdir -p "$(dirname "$dest")"
    cp -a "$main/$rel" "$dest"
  done < <(git -C "$main" ls-files --others --exclude-standard)
}

handoff_track_graphite() {
  local sibling="$1" cfg trunk
  cfg="$(handoff_graphite_config "$sibling")" || return 0
  command -v gt >/dev/null 2>&1 || return 0
  if gt --cwd "$sibling" parent >/dev/null 2>&1; then
    return 0
  fi
  trunk="$(jq -r '.trunk // "main"' "$cfg" 2>/dev/null || true)"
  trunk="${trunk:-main}"
  gt --cwd "$sibling" track --parent "$trunk" --no-interactive \
    || gt --cwd "$sibling" track --force --no-interactive \
    || handoff_die "gt track failed for $sibling"
}

handoff_sibling_path() {
  local main="$1" branch="$2" path
  path="$(git -C "$main" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
    /^worktree / { p = substr($0, 10) }
    /^branch / && $2 == b { print p; exit }
  ')"
  if [[ -n "$path" && -d "$path" ]]; then
    printf '%s' "$path"
    return 0
  fi
  path="${main}.${branch}"
  [[ -d "$path" ]] || return 1
  printf '%s' "$path"
}

handoff_state_dir() {
  printf '%s/agentic-dev' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

handoff_remember() {
  local dir file
  dir="$(handoff_state_dir)"
  mkdir -p "$dir"
  file="$dir/handoffs.jsonl"
  printf '%s\n' "$1" >>"$file"
}

handoff_herdr_bin() {
  printf '%s' "${HERDR_BIN_PATH:-herdr}"
}

handoff_herdr_socket_ok() {
  "$(handoff_herdr_bin)" workspace list >/dev/null 2>&1
}

handoff_parent_workspace() {
  local ws="${HANDOFF_WORKSPACE:-${HERDR_WORKSPACE_ID:-}}"
  [[ -n "$ws" ]] || return 1
  printf '%s' "$ws"
}

handoff_bool_json() {
  if [[ "$1" -eq 1 ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

handoff_result_json() {
  local label="$1" sibling="$2" branch="$3" issue="$4" started="$5" copied="$6" graphite="$7"
  jq -nc \
    --arg label "$label" \
    --arg path "$sibling" \
    --arg branch "$branch" \
    --arg issue "$issue" \
    --argjson agent_started "$(handoff_bool_json "$started")" \
    --argjson dirty_copied "$(handoff_bool_json "$copied")" \
    --argjson graphite "$(handoff_bool_json "$graphite")" \
    '{ok:true,label:$label,path:$path,branch:$branch,issue:$issue,agent_started:$agent_started,dirty_copied:$dirty_copied,graphite:$graphite}'
}

handoff_info_json() {
  local cwd branch helper default_copy
  local herdr_env=0 socket=0 herdr=0 main_ok=0 dirty=0 graphite=0 helper_present=0 beads=0
  cwd="$(handoff_realpath "$PWD")"
  [[ "${HERDR_ENV:-}" == 1 ]] && herdr_env=1
  if handoff_herdr_socket_ok; then
    socket=1
  fi
  if [[ "$herdr_env" -eq 1 || "$socket" -eq 1 ]]; then
    herdr=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_is_main_checkout "$cwd"; then
    main_ok=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_main_is_dirty "$cwd"; then
    dirty=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_is_graphite "$cwd"; then
    graphite=1
  fi
  branch="$(git -C "$cwd" branch --show-current 2>/dev/null || true)"
  helper="${HOME}/.config/worktrunk/herdr-layout.sh"
  [[ -f "$helper" ]] && helper_present=1
  if [[ "$dirty" -eq 1 ]]; then
    default_copy="dirty"
  else
    default_copy="clean"
  fi
  if handoff_bin_present "$(handoff_bd_bin)"; then
    beads=1
  fi
  jq -nc \
    --arg cwd "$cwd" \
    --arg branch "$branch" \
    --arg default_copy "$default_copy" \
    --arg helper "$helper" \
    --arg workspace "${HANDOFF_WORKSPACE:-${HERDR_WORKSPACE_ID:-}}" \
    --argjson stages "$(handoff_stage_names_json)" \
    --argjson herdr "$(handoff_bool_json "$herdr")" \
    --argjson herdr_env "$(handoff_bool_json "$herdr_env")" \
    --argjson socket "$(handoff_bool_json "$socket")" \
    --argjson main_checkout "$(handoff_bool_json "$main_ok")" \
    --argjson dirty "$(handoff_bool_json "$dirty")" \
    --argjson graphite "$(handoff_bool_json "$graphite")" \
    --argjson helper_present "$(handoff_bool_json "$helper_present")" \
    --argjson beads "$(handoff_bool_json "$beads")" \
    '{
      herdr:$herdr,
      herdr_env:$herdr_env,
      socket:$socket,
      main_checkout:$main_checkout,
      cwd:$cwd,
      branch:$branch,
      dirty:$dirty,
      graphite:$graphite,
      default_copy:$default_copy,
      helper:$helper,
      helper_present:$helper_present,
      workspace:$workspace,
      beads:$beads,
      stages:$stages
    }'
}

handoff_spawn_main() {
  local branch="" dirty="auto" issue="" prompt main sibling label intro graphite=0 copied=0
  local helper="${HOME:-}/.config/worktrunk/herdr-layout.sh"
  local json parent_ws info=0 started=0
  local stage="" worktree="" resume="" dry=0 mode="" binary="" binary_override="" pane_bin=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) handoff_usage ;;
      --info) info=1; shift ;;
      --dirty) dirty=1; shift ;;
      --clean) dirty=0; shift ;;
      --issue)
        [[ $# -ge 2 ]] || handoff_usage
        issue="$2"
        shift 2
        ;;
      --stage)
        [[ $# -ge 2 ]] || handoff_usage
        stage="$2"
        shift 2
        ;;
      --worktree)
        [[ $# -ge 2 ]] || handoff_usage
        worktree="$2"
        shift 2
        ;;
      --resume)
        [[ $# -ge 2 ]] || handoff_usage
        resume="$2"
        shift 2
        ;;
      --dry-run) dry=1; shift ;;
      --binary)
        [[ $# -ge 2 ]] || handoff_usage
        binary_override="$2"
        shift 2
        ;;
      --branch)
        [[ $# -ge 2 ]] || handoff_usage
        branch="$2"
        shift 2
        ;;
      --workspace)
        [[ $# -ge 2 ]] || handoff_usage
        HANDOFF_WORKSPACE="$2"
        shift 2
        ;;
      --)
        handoff_die "there is no prompt argument; write a beads issue and pass --issue ID"
        ;;
      -*) handoff_usage ;;
      *)
        [[ -z "$branch" ]] || handoff_die "unexpected argument: $1 (the job is a beads issue: --issue ID)"
        branch="$1"
        shift
        ;;
    esac
  done

  if [[ "$info" -eq 1 ]]; then
    command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
    handoff_info_json
    printf '\n'
    return 0
  fi

  [[ -n "$stage" ]] || handoff_die "--stage start|codex|cursor is required; bercail does not pick a harness"
  mode="$(handoff_stage_field "$stage" mode)" || handoff_die "unknown stage: $stage"
  case "$mode" in
    headless|pane) ;;
    *) handoff_die "stage $stage has unknown mode: $mode" ;;
  esac
  [[ -n "$issue" ]] || handoff_die "--issue <beads id> is required; the job lives in that issue"
  handoff_issue_id_ok "$issue" || handoff_die "not a beads issue id: $issue"
  binary="$(handoff_stage_field "$stage" binary)" || handoff_die "unknown stage: $stage"
  if [[ -n "$branch" ]]; then
    [[ -z "$binary_override" ]] || handoff_die "stage $stage --branch is a sticky pane; --binary is for headless stages"
    [[ -z "$resume" && "$dry" -eq 0 && -z "$worktree" ]] \
      || handoff_die "stage $stage --branch is a sticky pane; --resume/--dry-run/--worktree are for headless stages"
    pane_bin="$(handoff_headless_bin "$binary")"
    if ! handoff_bin_present "$pane_bin"; then
      handoff_die "requested harness $binary is not on PATH. Install it, or name another stage yourself (bercail harness lists what is present). Bercail does not switch harnesses."
    fi
  elif [[ "$mode" == headless ]]; then
    [[ "$dirty" == auto ]] || handoff_die "stage $stage does not copy a dirty tree"
    handoff_run_headless "$stage" "$worktree" "$issue" "$resume" "$dry" "$binary_override"
    return 0
  else
    handoff_usage
  fi

  command -v git >/dev/null 2>&1 || handoff_die "git is required"
  command -v wt >/dev/null 2>&1 || handoff_die "wt (worktrunk) is required"
  command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
  handoff_bin_present "$(handoff_bd_bin)" \
    || handoff_die "bd (beads) is not on PATH; the job is a beads issue (bercail update installs beads)"
  [[ -f "$helper" ]] || handoff_die "missing $helper"

  main="$(handoff_realpath "$PWD")"
  handoff_issue_exists "$main" "$issue" || handoff_die "beads issue $issue not found (bd show $issue)"

  if [[ "${HERDR_ENV:-}" == 1 ]]; then
    parent_ws="$(handoff_parent_workspace || true)"
  elif handoff_herdr_socket_ok; then
    parent_ws="$(handoff_parent_workspace)" \
      || handoff_die "not inside a Herdr pane; pass --workspace <id> (HERDR_ENV is unset)"
  else
    handoff_die "cannot reach Herdr (HERDR_ENV unset and herdr workspace list failed)"
  fi

  handoff_is_main_checkout "$main" \
    || handoff_die "cwd is not the main git checkout; refuse to spawn from a linked worktree"

  if [[ "$dirty" == "auto" ]]; then
    if handoff_main_is_dirty "$main"; then
      dirty=1
    else
      dirty=0
    fi
  fi

  # shellcheck disable=SC1090
  source "$helper"

  if [[ -n "$parent_ws" ]]; then
    export WT_HERDR_KEEP_FOCUS="$parent_ws"
  fi
  wt switch --create "$branch" --no-cd \
    || handoff_die "wt switch --create $branch failed"
  _wt_herdr_keep_user_focus "$parent_ws"
  sibling="$(handoff_sibling_path "$main" "$branch")" \
    || handoff_die "could not resolve sibling worktree for $branch"
  sibling="$(handoff_realpath "$sibling")"

  if [[ "$dirty" == 1 ]]; then
    if handoff_main_is_dirty "$main"; then
      handoff_copy_dirty "$main" "$sibling"
      copied=1
    fi
  fi

  if handoff_is_graphite "$sibling"; then
    graphite=1
    handoff_track_graphite "$sibling"
  fi

  label="$(_wt_generate_session_name "$sibling")"

  # The checkout facts used to be a prompt preamble. They go on the issue now.
  intro="$(printf 'bercail handoff: stage %s, pane %s, linked worktree %s (branch %s). Stay in this checkout. Do not open Review or invoke the review skill; tuicr opens itself when the agent pane goes done. Layout plugin id is agentic-dev.layout, never agentic-dev.dev-layout.' \
    "$stage" "$binary" "$sibling" "$branch")"
  if [[ "$graphite" -eq 1 ]]; then
    intro="$(printf '%s\nUse gt, not raw git commit/push, unless asked.' "$intro")"
  fi
  handoff_issue_comment "$sibling" "$issue" "$intro"

  prompt="$(handoff_issue_prompt "$issue")"

  # Pane stages publish the table binary through WT_HERDR_AGENT_CMD and the
  # one-line prompt (the issue id) through WT_HERDR_AGENT_PROMPT. No file.
  if WT_HERDR_KEEP_FOCUS="$parent_ws" \
    WT_HERDR_AGENT_CMD="$pane_bin" \
    WT_HERDR_AGENT_PROMPT="$prompt" \
    wt_herdr_handoff_agent "$label" "$sibling"; then
    started=1
  else
    echo "handoff-spawn: handoff-agent did not confirm a live agent; worktree is still $sibling ($label)" >&2
  fi

  json="$(handoff_result_json "$label" "$sibling" "$branch" "$issue" "$started" "$copied" "$graphite")"
  handoff_remember "$json"
  printf '%s\n' "$json"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  handoff_spawn_main "$@"
fi
