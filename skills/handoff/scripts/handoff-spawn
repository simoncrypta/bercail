#!/usr/bin/env bash
# Handoff router: a named stage picks binary, headless vs desk agent, model, worktree.
# The job is a beads issue; the agent prompt is one line pointing at it.
# shellcheck shell=bash
set -euo pipefail

handoff_die() {
  printf 'handoff-spawn: %s\n' "$*" >&2
  exit 1
}

_HANDOFF_SPAWN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=skills/handoff/scripts/handoff-stages.sh
source "$_HANDOFF_SPAWN_DIR/handoff-stages.sh"
# shellcheck source=skills/handoff/scripts/git-backend.sh
source "$_HANDOFF_SPAWN_DIR/git-backend.sh"

handoff_usage() {
  cat >&2 <<'EOF'
usage: handoff-spawn --info
       handoff-spawn --stage start|codex|cursor|bstack|autopilot --issue ID --worktree PATH
                     [--binary claude|codex|cursor-agent|opencode|pi] [--resume SESSION] [--dry-run]
       handoff-spawn --branch <name> --stage start|codex|cursor|bstack --issue ID
                     [--dirty|--clean] [--space <id>] [--base <branch>]

  --info          print JSON facts and exit
  --issue ID      beads issue to work (bd show ID). It holds the detail. The
                  agent's whole prompt is the id and its short title, for every harness.
  --stage NAME    required; named stage (see handoff-stages.sh). start is claude,
                  codex is Codex CLI, cursor is cursor-agent. bstack and autopilot
                  are Pi (the lead profile) unless [bstack] harness = "opencode",
                  which keeps opencode. autopilot may commit and push a PR's fixes;
                  headless only, --worktree on the PR's checkout. Without --branch
                  the stage runs headless (same result file). With --branch it opens
                  a space whose desk agent runs that stage's binary. Bercail has no default.
  --binary NAME   headless only: claude, codex, cursor-agent, opencode, or pi.
                  Overrides the stage table binary. opencode and pi keep the stage's
                  provider (start: claude, codex: gpt, cursor and bstack: lead).
                  Autopilot accepts only pi or opencode. Bercail never switches it for you.
  --worktree PATH checkout for a headless stage (default: cwd)
  --resume ID     re-handoff: claude --resume, cursor-agent --resume,
                  codex exec resume, opencode run --session, or pi --session-id
                  (a uuid; an opencode ses_ id cannot be resumed on Pi)
  --dry-run       print the headless command as JSON; no run, no issue check, no comment
  --branch NAME   feature branch for a new space with a desk agent (any stage)
  --dirty         copy uncommitted main changes into the sibling as a working tree
                  (default when main is dirty)
  --clean         HEAD only; leave uncommitted files on main
  --space ID      Herdr app space to keep shown (default: the one shown now;
                  --workspace is the same flag)
  --base BRANCH   --branch only: cut the new branch from BRANCH instead of the
                  default branch (wt switch --create --base), so a dependent
                  issue stacks on its parent's branch. The repo's git backend
                  records that parent (gh stack, gt track, or origin stack track).

Shep writes the beads issue first and owns the workflow. There are no prompt
files and no per-harness modes. Each real handoff adds a bd comment to the
issue with the worktree (and, headless, the result file).
EOF
  exit 2
}

handoff_realpath() {
  local path="$1"
  (cd "$path" 2>/dev/null && pwd -P) || printf '%s' "$path"
}

handoff_git_main() {
  git -C "$1" worktree list --porcelain 2>/dev/null \
    | awk '/^worktree / { print substr($0, 10); exit }'
}

handoff_is_main_checkout() {
  local cwd main
  cwd="$(handoff_realpath "$1")"
  main="$(handoff_git_main "$1")"
  [[ -n "$main" ]] || return 1
  [[ "$cwd" == "$(handoff_realpath "$main")" ]]
}

handoff_main_is_dirty() {
  [[ -n "$(git -C "$1" status --porcelain --untracked-files=all 2>/dev/null)" ]]
}

# Wrappers so callers written against the Graphite bool keep working.
# Detection lives in git-backend.sh (no gt).
handoff_graphite_config() {
  git_backend_graphite_config "$1"
}

handoff_is_graphite() {
  local name rc=0
  name="$(git_backend "$1")" || rc=$?
  [[ "$rc" -ne 130 ]] || exit 130
  [[ "$name" == gt ]]
}

# Copy main's uncommitted tracked+untracked files into sibling as a working
# tree. Never git-add. After this: git diff --cached is empty; git diff HEAD
# matches main's dirty tracked files; untracked files exist on disk only.
handoff_copy_dirty() {
  local main="$1" sibling="$2" patch rel dest
  [[ -d "$main" && -d "$sibling" ]] || return 1
  patch="$(mktemp)"
  git -C "$main" diff HEAD --binary >"$patch" || true
  if [[ -s "$patch" ]]; then
    git -C "$sibling" apply --whitespace=nowarn "$patch" \
      || handoff_die "git apply of dirty working tree failed"
  fi
  rm -f "$patch"
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    dest="$sibling/$rel"
    mkdir -p "$(dirname "$dest")"
    cp -a "$main/$rel" "$dest"
  done < <(git -C "$main" ls-files --others --exclude-standard)
}

# Run a command in its own process group, so its children die with it. Status
# 124 when it outlives $1 seconds. Not timeout(1): macOS has none.
handoff_bounded() {
  local ticks=$(($1 * 10)) pid rc
  shift
  (
    # Job control only for the fork: it is what gives the command its own group.
    # Left on, bash also prints a notice ("[1]+ Done") when the command ends.
    set -m
    "$@" &
    pid=$!
    set +m
    # gt left the terminal's group with set -m, so Ctrl-C only reaches it from here.
    # Die by the signal: on a plain exit 130 the caller would carry on to the next gt.
    trap 'kill -KILL -- "-$pid" 2>/dev/null; trap - INT; kill -INT 0' INT
    trap 'kill -KILL -- "-$pid" 2>/dev/null; exit 143' TERM
    while kill -0 "$pid" 2>/dev/null; do
      if [[ "$ticks" -le 0 ]]; then
        kill -TERM -- "-$pid" 2>/dev/null || true
        sleep 1
        kill -KILL -- "-$pid" 2>/dev/null || true
        wait "$pid" 2>/dev/null || true
        exit 124
      fi
      ticks=$((ticks - 1))
      sleep 0.1
    done
    rc=0
    wait "$pid" || rc=$?
    # A child left behind would hold the caller's pipes open.
    kill -KILL -- "-$pid" 2>/dev/null || true
    exit "$rc"
  )
}

handoff_gt_timeout() {
  local secs="${HANDOFF_GT_TIMEOUT:-30}"
  [[ "$secs" =~ ^[1-9][0-9]*$ ]] || secs=30
  printf '%s' "$secs"
}

# No gt call can hold the spawn or answer a prompt, and stdout is the spawn's JSON.
handoff_gt() {
  local sibling="$1"
  shift
  handoff_bounded "$(handoff_gt_timeout)" gt --cwd "$sibling" "$@" --no-interactive </dev/null >&2
}

# Repair only when gt says the parent is untracked or unknown. Other errors
# (such as a locked database) must never re-parent an existing stack.
handoff_gt_track() {
  local sibling="$1" parent="$2" trunk="$3" rc=0 info
  handoff_gt "$sibling" track --parent "$parent" || rc=$?
  [[ "$rc" -ne 0 && "$rc" -ne 124 && "$parent" != "$trunk" ]] || return "$rc"
  rc=0
  info="$(handoff_gt "$sibling" branch info --branch "$parent" 2>&1)" || rc=$?
  [[ "$rc" -ne 124 ]] || return 124
  [[ "$rc" -ne 0 && ( "$info" == *"untracked branch"* || "$info" == *"Could not find branch"* ) ]] || return 1
  rc=0
  handoff_gt "$sibling" track "$parent" --parent "$trunk" || rc=$?
  [[ "$rc" -ne 124 ]] || return 124
  if [[ "$rc" -eq 0 ]]; then
    rc=0
    handoff_gt "$sibling" track --parent "$parent" || rc=$?
    [[ "$rc" -ne 0 ]] || return 0
    [[ "$rc" -ne 124 ]] || return 124
  fi
  printf 'handoff-spawn: gt could not track %s as the parent; using trunk %s.\n' "$parent" "$trunk" >&2
  handoff_gt "$sibling" track --parent "$trunk"
}

# parent: the branch the new one was cut from (--base); default is trunk.
# Never fails the spawn: the worktree and its space exist by now, so a gt problem
# is a warning and the desk still starts.
handoff_track_graphite() {
  local sibling="$1" parent="${2:-}" cfg trunk rc=0
  # gt would auto-init here, on a trunk it guessed.
  if ! cfg="$(handoff_graphite_config "$sibling")"; then
    printf 'handoff-spawn: Graphite is on for this repo but it has no gt config; not tracking %s. Run gt init, then gt track.\n' "$sibling" >&2
    return 0
  fi
  command -v gt >/dev/null 2>&1 || return 0
  handoff_gt "$sibling" parent >/dev/null 2>&1 || rc=$?
  [[ "$rc" -ne 0 ]] || return 0
  trunk="$(jq -r '.trunk // .trunks[0].name // "main"' "$cfg" 2>/dev/null || true)"
  trunk="${trunk:-main}"
  parent="${parent:-$trunk}"
  if [[ "$rc" -ne 124 ]]; then
    rc=0
    handoff_gt_track "$sibling" "$parent" "$trunk" || rc=$?
  fi
  case "$rc" in
    0) return 0 ;;
    124) printf 'handoff-spawn: gt did not finish in %ss; ' "$(handoff_gt_timeout)" >&2 ;;
    *) printf 'handoff-spawn: gt failed; ' >&2 ;;
  esac
  printf 'the desk starts anyway, untracked. In %s run: gt track --parent %s\n' "$sibling" "$parent" >&2
}

handoff_trunk_name() {
  local root="$1" ref name
  ref="$(git -C "$root" symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [[ "$ref" == refs/remotes/origin/* ]]; then
    printf '%s' "${ref#refs/remotes/origin/}"
    return 0
  fi
  name="$(git -C "$root" config --get init.defaultBranch 2>/dev/null || true)"
  if [[ -n "$name" ]] && git -C "$root" show-ref --verify --quiet "refs/heads/$name"; then
    printf '%s' "$name"
    return 0
  fi
  if git -C "$root" show-ref --verify --quiet refs/heads/master; then
    printf 'master'
    return 0
  fi
  printf 'main'
}

handoff_worktree_of() {
  local root="$1" branch="$2" path
  path="$(git -C "$root" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
    /^worktree / { p = substr($0, 10) }
    /^branch / && $2 == b { print p; exit }
  ')"
  [[ -n "$path" && -d "$path" ]] || return 1
  printf '%s' "$path"
}

handoff_gh_catalog() {
  local dir
  dir="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  printf '%s/gh-stack' "$dir"
}

# gh stack add only appends at the current top, and it uses the cwd's branch.
# Run it where that parent is checked out. A missing checkout gets a temp
# worktree so main is not switched. Never -A/-u/-m: adoption is metadata-only.
# A parent that is in a stack but not the top is refused: init would reject it,
# and add would attach the child to the wrong branch.
handoff_track_gh() {
  local sibling="$1" branch="$2" parent="$3" main catalog trunk wt tmp="" rc=0
  command -v gh >/dev/null 2>&1 || {
    printf 'handoff-spawn: gh is not on PATH; not recording the stack. In %s run: gh stack init %s %s\n' \
      "$sibling" "$parent" "$branch" >&2
    return 0
  }
  main="$(git_backend_main "$sibling")" || main="$sibling"
  catalog="$(handoff_gh_catalog "$sibling")"
  trunk="$(handoff_trunk_name "$main")"
  if [[ -f "$catalog" ]] && jq -e --arg p "$parent" \
    'any(.stacks[]?; any(.branches[]?; .branch == $p))' "$catalog" >/dev/null 2>&1; then
    if ! jq -e --arg p "$parent" 'any(.stacks[]?; .branches[-1].branch == $p)' "$catalog" >/dev/null 2>&1; then
      printf 'handoff-spawn: %s is not the top of its gh stack; not attaching %s. gh stack add only extends the top.\n' \
        "$parent" "$branch" >&2
      return 0
    fi
    wt="$(handoff_worktree_of "$main" "$parent" || true)"
    if [[ -z "$wt" ]]; then
      tmp="$(mktemp -d)"
      if ! git -C "$main" worktree add --quiet "$tmp" "$parent" >&2; then
        printf 'handoff-spawn: could not check out %s to run gh stack add; the desk starts anyway.\n' "$parent" >&2
        rm -rf "$tmp"
        return 0
      fi
      wt="$tmp"
    fi
    (
      cd "$wt" || exit 1
      handoff_bounded "$(handoff_gt_timeout)" gh stack add "$branch" </dev/null >&2
    ) || rc=$?
    if [[ -n "$tmp" ]]; then
      git -C "$main" worktree remove --force "$tmp" >&2 || true
      rm -rf "$tmp"
    fi
  elif [[ "$parent" == "$trunk" ]]; then
    (
      cd "$sibling" || exit 1
      handoff_bounded "$(handoff_gt_timeout)" gh stack init --base "$trunk" "$branch" </dev/null >&2
    ) || rc=$?
  else
    (
      cd "$sibling" || exit 1
      handoff_bounded "$(handoff_gt_timeout)" gh stack init --base "$trunk" "$parent" "$branch" </dev/null >&2
    ) || rc=$?
  fi
  [[ "$rc" -eq 0 ]] || printf 'handoff-spawn: gh stack did not record %s on %s; the desk starts anyway.\n' \
    "$branch" "$parent" >&2
}

# origin stack track is local. It does not publish and does not need a PR.
handoff_track_origin() {
  local sibling="$1" branch="$2" parent="$3" rc=0
  command -v origin >/dev/null 2>&1 || {
    printf 'handoff-spawn: origin is not on PATH; not recording the stack. In %s run: origin stack track %s --onto %s\n' \
      "$sibling" "$branch" "$parent" >&2
    return 0
  }
  (
    cd "$sibling" || exit 1
    handoff_bounded "$(handoff_gt_timeout)" origin stack track "$branch" --onto "$parent" --json </dev/null >&2
  ) || rc=$?
  [[ "$rc" -eq 0 ]] || printf 'handoff-spawn: origin stack track did not record %s on %s; the desk starts anyway. In %s run: origin stack track %s --onto %s\n' \
    "$branch" "$parent" "$sibling" "$branch" "$parent" >&2
}

handoff_sibling_path() {
  local main="$1" branch="$2" path
  path="$(git -C "$main" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
    /^worktree / { p = substr($0, 10) }
    /^branch / && $2 == b { print p; exit }
  ')"
  if [[ -n "$path" && -d "$path" ]]; then
    printf '%s' "$path"
    return 0
  fi
  path="${main}.${branch}"
  [[ -d "$path" ]] || return 1
  printf '%s' "$path"
}

handoff_state_dir() {
  printf '%s/agentic-dev' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

handoff_remember() {
  local dir file
  dir="$(handoff_state_dir)"
  mkdir -p "$dir"
  file="$dir/handoffs.jsonl"
  printf '%s\n' "$1" >>"$file"
}

handoff_herdr_app_bin() {
  printf '%s' "${HERDR_APP_BIN:-herdr-app}"
}

# The Herdr app answers (its window is open).
handoff_herdr_socket_ok() {
  "$(handoff_herdr_app_bin)" status >/dev/null 2>&1
}

# The space to keep shown: --space, else the one the user is looking at.
handoff_shown_space() {
  local ws="${HANDOFF_SPACE:-}"
  [[ -n "$ws" ]] || ws="$("$(handoff_herdr_app_bin)" status 2>/dev/null | jq -r '.space // empty')"
  [[ -n "$ws" ]] || return 1
  printf '%s' "$ws"
}

# A desk in a repo that no notify sink covers posts nowhere: bercail says so
# on stderr, with the command that fixes it. Never fails the spawn.
handoff_notify_check() {
  local bercail="${BERCAIL_BIN:-bercail}"
  command -v "$bercail" >/dev/null 2>&1 || return 0
  "$bercail" notify check "$1" </dev/null >/dev/null || true
}

handoff_bool_json() {
  if [[ "$1" -eq 1 ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

handoff_result_json() {
  local label="$1" sibling="$2" branch="$3" issue="$4" started="$5" copied="$6" graphite="$7"
  local stage="${8:-}" harness="${9:-}" space="${10:-}" desk="${11:-}" issue_title="${12:-}"
  # stage/harness: what the desk agent runs; space/desk: where it runs (hc address).
  jq -nc \
    --arg label "$label" \
    --arg path "$sibling" \
    --arg branch "$branch" \
    --arg issue "$issue" \
    --argjson agent_started "$(handoff_bool_json "$started")" \
    --argjson dirty_copied "$(handoff_bool_json "$copied")" \
    --argjson graphite "$(handoff_bool_json "$graphite")" \
    --arg stage "$stage" \
    --arg harness "$harness" \
    --arg space "$space" \
    --arg desk "$desk" \
    --arg issue_title "$issue_title" \
    '{ok:true,label:$label,path:$path,branch:$branch,issue:$issue,agent_started:$agent_started,dirty_copied:$dirty_copied,graphite:$graphite}
     + (if $stage == "" then {} else {stage:$stage} end)
     + (if $harness == "" then {} else {harness:$harness} end)
     + (if $space == "" then {} else {space:$space} end)
     + (if $desk == "" then {} else {desk:$desk} end)
     + (if $issue_title == "" then {} else {issue_title:$issue_title} end)'
}

handoff_info_json() {
  local cwd branch helper default_copy backend=gh
  local herdr_env=0 socket=0 herdr=0 main_ok=0 dirty=0 graphite=0 helper_present=0 beads=0
  cwd="$(handoff_realpath "$PWD")"
  [[ -n "${HC_TERMINAL_ID:-}" ]] && herdr_env=1
  if handoff_herdr_socket_ok; then
    socket=1
  fi
  if [[ "$socket" -eq 1 ]]; then
    herdr=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_is_main_checkout "$cwd"; then
    main_ok=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_main_is_dirty "$cwd"; then
    dirty=1
  fi
  if command -v git >/dev/null 2>&1; then
    local info_rc=0
    backend="$(git_backend "$cwd")" || info_rc=$?
    [[ "$info_rc" -ne 130 ]] || exit 130
    [[ "$backend" == gt ]] && graphite=1
  fi
  branch="$(git -C "$cwd" branch --show-current 2>/dev/null || true)"
  helper="${HOME}/.config/worktrunk/herdr-layout.sh"
  [[ -f "$helper" ]] && helper_present=1
  if [[ "$dirty" -eq 1 ]]; then
    default_copy="dirty"
  else
    default_copy="clean"
  fi
  if handoff_bin_present "$(handoff_bd_bin)"; then
    beads=1
  fi
  jq -nc \
    --arg cwd "$cwd" \
    --arg branch "$branch" \
    --arg default_copy "$default_copy" \
    --arg helper "$helper" \
    --arg space "$(handoff_shown_space 2>/dev/null || true)" \
    --argjson stages "$(handoff_stage_names_json)" \
    --argjson herdr "$(handoff_bool_json "$herdr")" \
    --argjson herdr_env "$(handoff_bool_json "$herdr_env")" \
    --argjson socket "$(handoff_bool_json "$socket")" \
    --argjson main_checkout "$(handoff_bool_json "$main_ok")" \
    --argjson dirty "$(handoff_bool_json "$dirty")" \
    --arg git "$backend" \
    --argjson graphite "$(handoff_bool_json "$graphite")" \
    --argjson helper_present "$(handoff_bool_json "$helper_present")" \
    --argjson beads "$(handoff_bool_json "$beads")" \
    '{
      herdr:$herdr,
      herdr_env:$herdr_env,
      socket:$socket,
      main_checkout:$main_checkout,
      cwd:$cwd,
      branch:$branch,
      dirty:$dirty,
      git:$git,
      graphite:$graphite,
      default_copy:$default_copy,
      helper:$helper,
      helper_present:$helper_present,
      space:$space,
      workspace:$space,
      beads:$beads,
      stages:$stages
    }'
}

handoff_spawn_main() {
  local branch="" dirty="auto" issue="" issue_title="" prompt main sibling label intro graphite=0 copied=0 backend=gh
  local helper="${HOME:-}/.config/worktrunk/herdr-layout.sh"
  local json keep_space info=0 started=0 space="" desk=""
  local stage="" worktree="" resume="" dry=0 mode="" binary="" binary_override="" desk_bin=""
  local base=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) handoff_usage ;;
      --info) info=1; shift ;;
      --dirty) dirty=1; shift ;;
      --clean) dirty=0; shift ;;
      --issue)
        [[ $# -ge 2 ]] || handoff_usage
        issue="$2"
        shift 2
        ;;
      --stage)
        [[ $# -ge 2 ]] || handoff_usage
        stage="$2"
        shift 2
        ;;
      --worktree)
        [[ $# -ge 2 ]] || handoff_usage
        worktree="$2"
        shift 2
        ;;
      --resume)
        [[ $# -ge 2 ]] || handoff_usage
        resume="$2"
        shift 2
        ;;
      --dry-run) dry=1; shift ;;
      --binary)
        [[ $# -ge 2 ]] || handoff_usage
        binary_override="$2"
        shift 2
        ;;
      --branch)
        [[ $# -ge 2 ]] || handoff_usage
        branch="$2"
        shift 2
        ;;
      --base)
        [[ $# -ge 2 ]] || handoff_usage
        base="$2"
        shift 2
        ;;
      --space|--workspace)
        [[ $# -ge 2 ]] || handoff_usage
        HANDOFF_SPACE="$2"
        shift 2
        ;;
      --)
        handoff_die "there is no prompt argument; write a beads issue and pass --issue ID"
        ;;
      -*) handoff_usage ;;
      *)
        [[ -z "$branch" ]] || handoff_die "unexpected argument: $1 (the job is a beads issue: --issue ID)"
        branch="$1"
        shift
        ;;
    esac
  done

  if [[ "$info" -eq 1 ]]; then
    command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
    handoff_info_json
    printf '\n'
    return 0
  fi

  [[ -n "$stage" ]] || handoff_die "--stage start|codex|cursor|bstack is required; bercail does not pick a harness"
  mode="$(handoff_stage_field "$stage" mode)" || handoff_die "unknown stage: $stage"
  case "$mode" in
    headless) ;;
    *) handoff_die "stage $stage has unknown mode: $mode" ;;
  esac
  [[ -n "$issue" ]] || handoff_die "--issue <beads id> is required; the job lives in that issue"
  handoff_issue_id_ok "$issue" || handoff_die "not a beads issue id: $issue"
  binary="$(handoff_stage_field "$stage" binary)" || handoff_die "unknown stage: $stage"
  [[ -z "$base" || -n "$branch" ]] \
    || handoff_die "--base needs --branch: it picks what the new desk branch is cut from; headless stages run in an existing --worktree"
  if [[ -n "$branch" ]]; then
    [[ "$stage" != autopilot ]] \
      || handoff_die "stage autopilot is headless: pass --worktree <the PR's checkout> instead of --branch"
    [[ -z "$binary_override" ]] || handoff_die "stage $stage --branch starts a desk agent; --binary is for headless stages"
    [[ -z "$resume" && "$dry" -eq 0 && -z "$worktree" ]] \
      || handoff_die "stage $stage --branch starts a desk agent; --resume/--dry-run/--worktree are for headless stages"
    if [[ "$binary" == pi ]]; then
      [[ "$(_handoff_bstack_get enabled)" == true ]] \
        || handoff_die "stage $stage on a Pi desk needs bstack on ([bstack] enabled = true). Run bercail bstack on."
      [[ -f "$(handoff_pi_lead_file)" ]] \
        || handoff_die "Pi lead profile is missing ($(handoff_pi_lead_file)). Run bercail update."
      # Empty: bercail-desk-agent runs the lead from lead.json when harness is Pi.
      desk_bin=""
    else
      desk_bin="$(handoff_headless_bin "$binary")"
      if ! handoff_bin_present "$desk_bin"; then
        handoff_die "requested harness $binary is not on PATH. Install it, or name another stage yourself (bercail harness lists what is present). Bercail does not switch harnesses."
      fi
    fi
  elif [[ "$mode" == headless ]]; then
    [[ "$dirty" == auto ]] || handoff_die "stage $stage does not copy a dirty tree"
    handoff_run_headless "$stage" "$worktree" "$issue" "$resume" "$dry" "$binary_override"
    return 0
  else
    handoff_usage
  fi

  command -v git >/dev/null 2>&1 || handoff_die "git is required"
  command -v wt >/dev/null 2>&1 || handoff_die "wt (worktrunk) is required"
  command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
  handoff_bin_present "$(handoff_bd_bin)" \
    || handoff_die "bd (beads) is not on PATH; the job is a beads issue (bercail update installs beads)"
  [[ -f "$helper" ]] || handoff_die "missing $helper"

  main="$(handoff_realpath "$PWD")"
  handoff_issue_exists "$main" "$issue" || handoff_die "beads issue $issue not found (bd show $issue)"
  issue_title="$(handoff_issue_title "$main" "$issue")"

  handoff_herdr_socket_ok \
    || handoff_die "cannot reach the Herdr app (herdr-app status failed); open it first"
  keep_space="$(handoff_shown_space || true)"

  handoff_is_main_checkout "$main" \
    || handoff_die "cwd is not the main git checkout; refuse to spawn from a linked worktree"

  if [[ "$dirty" == "auto" ]]; then
    if handoff_main_is_dirty "$main"; then
      dirty=1
    else
      dirty=0
    fi
  fi

  # shellcheck disable=SC1090
  source "$helper"

  if [[ -n "$keep_space" ]]; then
    export WT_HERDR_KEEP_FOCUS="$keep_space"
  fi
  # The post-start hook makes the space only: this starts the desk below.
  if [[ -n "$base" ]]; then
    git -C "$main" rev-parse --verify --quiet "$base^{commit}" >/dev/null \
      || handoff_die "--base $base is not a branch or commit in this repo"
    WT_HERDR_NO_DESK=1 wt switch --create "$branch" --base "$base" --no-cd \
      || handoff_die "wt switch --create $branch --base $base failed"
  else
    WT_HERDR_NO_DESK=1 wt switch --create "$branch" --no-cd \
      || handoff_die "wt switch --create $branch failed"
  fi
  _wt_herdr_keep_user_focus "$keep_space"
  sibling="$(handoff_sibling_path "$main" "$branch")" \
    || handoff_die "could not resolve sibling worktree for $branch"
  sibling="$(handoff_realpath "$sibling")"

  if [[ "$dirty" == 1 ]]; then
    if handoff_main_is_dirty "$main"; then
      handoff_copy_dirty "$main" "$sibling"
      copied=1
    fi
  fi

  local track_rc=0
  backend="$(git_backend "$sibling")" || track_rc=$?
  [[ "$track_rc" -ne 130 ]] || exit 130
  case "$backend" in
    gt)
      graphite=1
      handoff_track_graphite "$sibling" "$base"
      ;;
    gh)
      [[ -z "$base" ]] || handoff_track_gh "$sibling" "$branch" "$base"
      ;;
    origin)
      [[ -z "$base" ]] || handoff_track_origin "$sibling" "$branch" "$base"
      ;;
  esac

  label="$(_wt_generate_session_name "$sibling")"

  # Before the handoff comment and the desk agent, so both write to the main store.
  handoff_share_main_beads "$sibling"

  # The checkout facts used to be a prompt preamble. They go on the issue now.
  intro="$(printf 'bercail handoff: stage %s, desk agent %s, linked worktree %s (branch %s). Stay in this checkout. Stage your changes with git add and leave them uncommitted for human review in tuicr; never commit unless asked. Do not open Review or invoke the review skill; when the desk agent finishes, Review opens itself in this space once the user looks at it. When you stop, post your final report on this issue with bd comment %s: what changed, what you ran to prove it, and what is left or blocked.' \
    "$stage" "$binary" "$sibling" "$branch" "$issue")"
  if [[ "$graphite" -eq 1 ]]; then
    intro="$(printf '%s\nUse gt, not raw git commit/push, unless asked.' "$intro")"
  else
    intro="$(printf '%s\nGit backend is %s. Do not run gt.' "$intro" "$backend")"
    if [[ -n "$base" && "$backend" == gh ]]; then
      intro="$(printf '%s Stack %s on %s with gh stack init or gh stack add, then gh stack submit. Do not open a PR that only targets %s.' "$intro" "$branch" "$base" "$base")"
    elif [[ -n "$base" && "$backend" == origin ]]; then
      intro="$(printf '%s Stack %s on %s with origin stack track --onto and origin pr create --stack-on. Do not open a PR that only targets %s.' "$intro" "$branch" "$base" "$base")"
    fi
  fi
  handoff_issue_comment "$sibling" "$issue" "$intro"

  prompt="$(handoff_issue_prompt "$issue" "$issue_title")"

  # The desk gets the table binary through WT_HERDR_AGENT_CMD, the one-line
  # prompt through WT_HERDR_AGENT_PROMPT, and the issue through WT_HERDR_ISSUE
  # and WT_HERDR_ISSUE_TITLE. No file.
  # Pi passes an empty command so the desk agent runs the lead from lead.json.
  if WT_HERDR_KEEP_FOCUS="$keep_space" \
    WT_HERDR_AGENT_CMD="$desk_bin" \
    WT_HERDR_AGENT_PROMPT="$prompt" \
    WT_HERDR_ISSUE="$issue" \
    WT_HERDR_ISSUE_TITLE="$issue_title" \
    wt_herdr_handoff_agent "$label" "$sibling"; then
    started=1
  else
    echo "handoff-spawn: the desk agent did not start; worktree is still $sibling ($label)" >&2
  fi

  space="$(_wt_herdr_space_by_folder "$sibling" 2>/dev/null || true)"
  [[ -z "$space" ]] || desk="$(_wt_herdr_space_desk "$space" 2>/dev/null || true)"
  json="$(handoff_result_json "$label" "$sibling" "$branch" "$issue" "$started" "$copied" "$graphite" "$stage" "$binary" "$space" "$desk" "$issue_title")"
  [[ -z "$base" ]] || json="$(jq -c --arg base "$base" '. + {base:$base}' <<<"$json")"
  handoff_notify_check "$sibling"
  handoff_remember "$json"
  printf '%s\n' "$json"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  handoff_spawn_main "$@"
fi
