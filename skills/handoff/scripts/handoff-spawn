#!/usr/bin/env bash
# Handoff router: bstack or autopilot on Pi, headless unless --branch starts a desk.
# The job is a beads issue; the agent prompt is one line pointing at it.
# shellcheck shell=bash
set -euo pipefail

handoff_die() {
  printf 'handoff-spawn: %s\n' "$*" >&2
  exit 1
}

_HANDOFF_SPAWN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=skills/handoff/scripts/handoff-stages.sh
source "$_HANDOFF_SPAWN_DIR/handoff-stages.sh"

handoff_usage() {
  cat >&2 <<'EOF'
usage: handoff-spawn --info
       handoff-spawn --stage bstack|autopilot --issue ID --worktree PATH
                     [--resume SESSION] [--dry-run] [--model PROVIDER/MODEL[:thinking]]
       handoff-spawn --branch <name> --stage bstack|autopilot --issue ID
                     [--dirty|--clean] [--space <id>] [--base <branch>]
                     [--existing-branch] [--target task:ID|pr:N]
                     [--model PROVIDER/MODEL[:thinking]] [--adopt-reason TEXT]

  --info          print JSON facts and exit
  --issue ID      beads issue to work (bd show ID). It holds the detail. The
                  agent's whole prompt is one line: the id, its short title,
                  and run bd show ID.
  --stage NAME    required; bstack or autopilot (see handoff-stages.sh). Both
                  run Pi (the lead profile). autopilot may commit and push a
                  PR's fixes. Without --branch the stage runs headless (same
                  result file); autopilot then takes --worktree on the PR's
                  checkout. With --branch, the stage opens a space whose desk
                  runs Pi's lead; an autopilot desk needs --target pr:N and a
                  branch that exists (--existing-branch, or an adoption).
                  Bercail has no default.
  --worktree PATH checkout for a headless stage (default: cwd)
  --resume ID     re-handoff: pi --session-id (a uuid)
  --dry-run       print the headless command as JSON; no run, no issue or model
                  check, no comment
  --model M       run this one agent on Pi model M (provider/id, as pi
                  --list-models names it) instead of the lead's. The rest of
                  the lead stays. A :thinking suffix is kept; without one it
                  gets the lead's. An unknown model is refused before anything
                  starts. Sibling roles (builder, judge, council) keep theirs.
  --branch NAME   feature branch for a new space with a desk agent. With no
                  Herdr window here, hc makes the spaces and any connected
                  window (a laptop's) shows them, without taking focus.
  --dirty         copy uncommitted main changes into the sibling as a working tree
                  (default when main is dirty)
  --clean         HEAD only; leave uncommitted files on main
  --space ID      Herdr app space to keep shown (default: the one shown now)
  --base BRANCH   --branch only: cut the new branch from BRANCH instead of the
                  default branch (wt switch --create --base), so a dependent
                  issue stacks on its parent's branch. The repo's git backend
                  records that parent (gh stack, gt track, or origin stack track).
  --existing-branch
                  --branch only: the branch is on origin already (a PR's head).
                  Fetch it and check it out at the fetched head with wt switch,
                  never --create. A local branch behind it is fast-forwarded;
                  one with commits origin lacks, or one already checked out,
                  is refused.
  --adopt-reason TEXT
                  --branch only, from bercail shep task dispatch: start a desk
                  with a new session in the existing worktree of --branch,
                  whose original desk is gone. No new branch, no dirty copy.
                  TEXT goes on the issue and in handoffs.jsonl.
  --reuse-worktree
                  --branch only, from bercail shep task dispatch: finish a
                  creation that stopped before its desk, in the existing clean
                  worktree of --branch.
  --released ID   from bercail shep task dispatch: ID was closed with bd
                  supersede --with this issue, so its handoffs no longer hold
                  the target. Repeatable.

Shep writes the beads issue first and owns the workflow. There are no prompt
files and no per-stage modes. Each real handoff adds a bd comment to the
issue with the worktree (and, headless, the result file).
EOF
  exit 2
}

handoff_is_main_checkout() {
  local cwd main
  cwd="$(_git_backend_realpath "$1")"
  main="$(git_backend_main "$1")" || return 1
  [[ "$cwd" == "$main" ]]
}

handoff_main_is_dirty() {
  [[ -n "$(git -C "$1" status --porcelain --untracked-files=all 2>/dev/null)" ]]
}


# Copy main's uncommitted tracked+untracked files into sibling as a working
# tree. Never git-add. After this: git diff --cached is empty; git diff HEAD
# matches main's dirty tracked files; untracked files exist on disk only.
handoff_copy_dirty() {
  local main="$1" sibling="$2" patch rel dest
  [[ -d "$main" && -d "$sibling" ]] || return 1
  patch="$(mktemp)"
  git -C "$main" diff HEAD --binary >"$patch" || true
  if [[ -s "$patch" ]]; then
    git -C "$sibling" apply --whitespace=nowarn "$patch" \
      || handoff_die "git apply of dirty working tree failed"
  fi
  rm -f "$patch"
  while IFS= read -r rel; do
    [[ -n "$rel" ]] || continue
    dest="$sibling/$rel"
    mkdir -p "$(dirname "$dest")"
    cp -a "$main/$rel" "$dest"
  done < <(git -C "$main" ls-files --others --exclude-standard)
}

handoff_gt_timeout() {
  local secs="${HANDOFF_GT_TIMEOUT:-30}"
  [[ "$secs" =~ ^[1-9][0-9]*$ ]] || secs=30
  printf '%s' "$secs"
}

# No gt call can hold the spawn or answer a prompt, and stdout is the spawn's JSON.
handoff_gt() {
  local sibling="$1"
  shift
  _git_backend_bounded "$(handoff_gt_timeout)" gt --cwd "$sibling" "$@" --no-interactive </dev/null >&2
}

# Repair only when gt says the parent is untracked or unknown. Other errors
# (such as a locked database) must never re-parent an existing stack.
handoff_gt_track() {
  local sibling="$1" parent="$2" trunk="$3" rc=0 info
  handoff_gt "$sibling" track --parent "$parent" || rc=$?
  [[ "$rc" -ne 0 && "$rc" -ne 124 && "$parent" != "$trunk" ]] || return "$rc"
  rc=0
  info="$(handoff_gt "$sibling" branch info --branch "$parent" 2>&1)" || rc=$?
  [[ "$rc" -ne 124 ]] || return 124
  [[ "$rc" -ne 0 && ( "$info" == *"untracked branch"* || "$info" == *"Could not find branch"* ) ]] || return 1
  rc=0
  handoff_gt "$sibling" track "$parent" --parent "$trunk" || rc=$?
  [[ "$rc" -ne 124 ]] || return 124
  if [[ "$rc" -eq 0 ]]; then
    rc=0
    handoff_gt "$sibling" track --parent "$parent" || rc=$?
    [[ "$rc" -ne 0 ]] || return 0
    [[ "$rc" -ne 124 ]] || return 124
  fi
  printf 'handoff-spawn: gt could not track %s as the parent; using trunk %s.\n' "$parent" "$trunk" >&2
  handoff_gt "$sibling" track --parent "$trunk"
}

# parent: the branch the new one was cut from (--base); default is trunk.
# Never fails the spawn: the worktree and its space exist by now, so a gt problem
# is a warning and the desk still starts.
handoff_track_graphite() {
  local sibling="$1" parent="${2:-}" cfg trunk rc=0
  # gt would auto-init here, on a trunk it guessed.
  if ! cfg="$(git_backend_graphite_config "$sibling")"; then
    printf 'handoff-spawn: Graphite is on for this repo but it has no gt config; not tracking %s. Run gt init, then gt track.\n' "$sibling" >&2
    return 0
  fi
  command -v gt >/dev/null 2>&1 || return 0
  handoff_gt "$sibling" parent >/dev/null 2>&1 || rc=$?
  [[ "$rc" -ne 0 ]] || return 0
  trunk="$(jq -r '.trunk // .trunks[0].name // "main"' "$cfg" 2>/dev/null || true)"
  trunk="${trunk:-main}"
  parent="${parent:-$trunk}"
  if [[ "$rc" -ne 124 ]]; then
    rc=0
    handoff_gt_track "$sibling" "$parent" "$trunk" || rc=$?
  fi
  case "$rc" in
    0) return 0 ;;
    124) printf 'handoff-spawn: gt did not finish in %ss; ' "$(handoff_gt_timeout)" >&2 ;;
    *) printf 'handoff-spawn: gt failed; ' >&2 ;;
  esac
  printf 'the desk starts anyway, untracked. In %s run: gt track --parent %s\n' "$sibling" "$parent" >&2
}

handoff_worktree_of() {
  local root="$1" branch="$2" path
  path="$(git -C "$root" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
    /^worktree / { p = substr($0, 10) }
    /^branch / && $2 == b { print p; exit }
  ')"
  [[ -n "$path" && -d "$path" ]] || return 1
  printf '%s' "$path"
}

handoff_gh_catalog() {
  local dir
  dir="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  printf '%s/gh-stack' "$dir"
}

# gh stack add only appends at the current top, and it uses the cwd's branch.
# Run it where that parent is checked out. A missing checkout gets a temp
# worktree so main is not switched. Never -A/-u/-m: adoption is metadata-only.
# A parent that is in a stack but not the top is refused: init would reject it,
# and add would attach the child to the wrong branch.
handoff_track_gh() {
  local sibling="$1" branch="$2" parent="$3" main catalog trunk wt tmp="" rc=0
  command -v gh >/dev/null 2>&1 || {
    printf 'handoff-spawn: gh is not on PATH; not recording the stack. In %s run: gh stack init %s %s\n' \
      "$sibling" "$parent" "$branch" >&2
    return 0
  }
  main="$(git_backend_main "$sibling")" || main="$sibling"
  catalog="$(handoff_gh_catalog "$sibling")"
  trunk="$(git_backend_trunk "$main")"
  if [[ -f "$catalog" ]] && jq -e --arg p "$parent" \
    'any(.stacks[]?; any(.branches[]?; .branch == $p))' "$catalog" >/dev/null 2>&1; then
    if ! jq -e --arg p "$parent" 'any(.stacks[]?; .branches[-1].branch == $p)' "$catalog" >/dev/null 2>&1; then
      printf 'handoff-spawn: %s is not the top of its gh stack; not attaching %s. gh stack add only extends the top.\n' \
        "$parent" "$branch" >&2
      return 0
    fi
    wt="$(handoff_worktree_of "$main" "$parent" || true)"
    if [[ -z "$wt" ]]; then
      tmp="$(mktemp -d)"
      if ! git -C "$main" worktree add --quiet "$tmp" "$parent" >&2; then
        printf 'handoff-spawn: could not check out %s to run gh stack add; the desk starts anyway.\n' "$parent" >&2
        rm -rf "$tmp"
        return 0
      fi
      wt="$tmp"
    fi
    (
      cd "$wt" || exit 1
      _git_backend_bounded "$(handoff_gt_timeout)" gh stack add "$branch" </dev/null >&2
    ) || rc=$?
    if [[ -n "$tmp" ]]; then
      git -C "$main" worktree remove --force "$tmp" >&2 || true
      rm -rf "$tmp"
    fi
  elif [[ "$parent" == "$trunk" ]]; then
    (
      cd "$sibling" || exit 1
      _git_backend_bounded "$(handoff_gt_timeout)" gh stack init --base "$trunk" "$branch" </dev/null >&2
    ) || rc=$?
  else
    (
      cd "$sibling" || exit 1
      _git_backend_bounded "$(handoff_gt_timeout)" gh stack init --base "$trunk" "$parent" "$branch" </dev/null >&2
    ) || rc=$?
  fi
  [[ "$rc" -eq 0 ]] || printf 'handoff-spawn: gh stack did not record %s on %s; the desk starts anyway.\n' \
    "$branch" "$parent" >&2
}

# origin stack track is local. It does not publish and does not need a PR.
handoff_track_origin() {
  local sibling="$1" branch="$2" parent="$3" rc=0
  command -v origin >/dev/null 2>&1 || {
    printf 'handoff-spawn: origin is not on PATH; not recording the stack. In %s run: origin stack track %s --onto %s\n' \
      "$sibling" "$branch" "$parent" >&2
    return 0
  }
  (
    cd "$sibling" || exit 1
    _git_backend_bounded "$(handoff_gt_timeout)" origin stack track "$branch" --onto "$parent" --json </dev/null >&2
  ) || rc=$?
  [[ "$rc" -eq 0 ]] || printf 'handoff-spawn: origin stack track did not record %s on %s; the desk starts anyway. In %s run: origin stack track %s --onto %s\n' \
    "$branch" "$parent" "$sibling" "$branch" "$parent" >&2
}

# A PR's branch on origin, checked out at the fetched head. Moving a local
# branch only ever fast-forwards it; anything else is the person's to sort out.
handoff_checkout_existing() {
  local main="$1" branch="$2" remote mine at
  _git_backend_bounded "$(handoff_gt_timeout)" git -C "$main" fetch --quiet origin \
    "+refs/heads/$branch:refs/remotes/origin/$branch" </dev/null >&2 \
    || handoff_die "git fetch origin $branch failed; the PR's head is unknown, so no desk started"
  remote="$(git -C "$main" rev-parse --verify --quiet "refs/remotes/origin/$branch^{commit}")" \
    || handoff_die "origin has no branch $branch"
  if mine="$(git -C "$main" rev-parse --verify --quiet "refs/heads/$branch^{commit}")"; then
    if at="$(handoff_worktree_of "$main" "$branch")"; then
      handoff_die "$branch is already checked out at $at; continue that desk, or remove the worktree (wt remove $branch) and retry"
    fi
    if [[ "$mine" != "$remote" ]]; then
      git -C "$main" merge-base --is-ancestor "$mine" "$remote" \
        || handoff_die "local $branch ($mine) has commits origin/$branch ($remote) lacks; push or drop them, then retry"
      git -C "$main" update-ref -m "handoff-spawn: fast-forward to origin/$branch" "refs/heads/$branch" "$remote" "$mine" \
        || handoff_die "could not fast-forward $branch to origin/$branch"
    fi
  fi
  WT_HERDR_NO_DESK=1 wt switch "$branch" --no-cd || handoff_die "wt switch $branch failed"
}

# The commit a new desk branch starts from: origin's trunk once fetched, when
# the local trunk is behind it, so a desk never starts on a base that has moved.
# A SHA, so the branch gets no upstream. Empty means wt's default (local trunk):
# no origin, a failed fetch, or a local trunk with commits origin lacks.
handoff_fresh_base() {
  local main="$1" trunk remote mine
  git -C "$main" remote get-url origin >/dev/null 2>&1 || return 0
  trunk="$(git_backend_trunk "$main")"
  if ! _git_backend_bounded "$(handoff_gt_timeout)" git -C "$main" fetch --quiet origin \
    "+refs/heads/$trunk:refs/remotes/origin/$trunk" </dev/null >&2; then
    printf 'handoff-spawn: git fetch origin %s failed; the desk starts on the local %s, which may be behind\n' "$trunk" "$trunk" >&2
    return 0
  fi
  remote="$(git -C "$main" rev-parse --verify --quiet "refs/remotes/origin/$trunk^{commit}")" || return 0
  mine="$(git -C "$main" rev-parse --verify --quiet "refs/heads/$trunk^{commit}")" || mine=""
  [[ -z "$mine" ]] || git -C "$main" merge-base --is-ancestor "$mine" "$remote" || return 0
  printf '%s' "$remote"
}

handoff_sibling_path() {
  local main="$1" branch="$2" path
  path="$(git -C "$main" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
    /^worktree / { p = substr($0, 10) }
    /^branch / && $2 == b { print p; exit }
  ')"
  if [[ -n "$path" && -d "$path" ]]; then
    printf '%s' "$path"
    return 0
  fi
  path="${main}.${branch}"
  [[ -d "$path" ]] || return 1
  printf '%s' "$path"
}

# One line per --branch spawn: the spawn JSON, plus the record's version and when it was written.
handoff_remember() {
  local dir="${XDG_STATE_HOME:-$HOME/.local/state}/bercail"
  mkdir -p "$dir"
  jq -c --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" '{v: 1, at: $at} + .' <<<"$1" >>"$dir/handoffs.jsonl"
}

handoff_herdr_app_bin() {
  printf '%s' "${HERDR_APP_BIN:-herdr-app}"
}

# The Herdr app answers (its window is open).
handoff_herdr_app_ok() {
  "$(handoff_herdr_app_bin)" status >/dev/null 2>&1
}

# A window here, else hc's core, which makes the space for any window to adopt.
handoff_herdr_ok() {
  handoff_herdr_app_ok || "${HC_BIN:-hc}" ls --json >/dev/null 2>&1
}

# The space to keep shown: --space, else the one the user is looking at.
handoff_shown_space() {
  local ws="${HANDOFF_SPACE:-}"
  [[ -n "$ws" ]] || ws="$("$(handoff_herdr_app_bin)" status 2>/dev/null | jq -r '.space // empty')"
  [[ -n "$ws" ]] || return 1
  printf '%s' "$ws"
}

# A desk in a repo that no notify sink covers posts nowhere: bercail says so
# on stderr, with the command that fixes it. Never fails the spawn.
handoff_notify_check() {
  local bercail="${BERCAIL_BIN:-bercail}"
  command -v "$bercail" >/dev/null 2>&1 || return 0
  "$bercail" notify check "$1" </dev/null >/dev/null || true
}

handoff_bool_json() {
  if [[ "$1" -eq 1 ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

handoff_result_json() {
  local label="$1" sibling="$2" branch="$3" issue="$4" started="$5" copied="$6" backend="$7"
  local stage="${8:-}" harness="${9:-}" space="${10:-}" desk="${11:-}" issue_title="${12:-}"
  # stage/harness: what the desk agent runs; space/desk: where it runs (hc address).
  jq -nc \
    --arg label "$label" \
    --arg path "$sibling" \
    --arg branch "$branch" \
    --arg issue "$issue" \
    --argjson agent_started "$(handoff_bool_json "$started")" \
    --argjson dirty_copied "$(handoff_bool_json "$copied")" \
    --arg git "$backend" \
    --arg stage "$stage" \
    --arg harness "$harness" \
    --arg space "$space" \
    --arg desk "$desk" \
    --arg issue_title "$issue_title" \
    '{ok:true,label:$label,path:$path,branch:$branch,issue:$issue,agent_started:$agent_started,dirty_copied:$dirty_copied,git:$git}
     + (if $stage == "" then {} else {stage:$stage} end)
     + (if $harness == "" then {} else {harness:$harness} end)
     + (if $space == "" then {} else {space:$space} end)
     + (if $desk == "" then {} else {desk:$desk} end)
     + (if $issue_title == "" then {} else {issue_title:$issue_title} end)'
}

handoff_info_json() {
  local cwd branch helper default_copy backend=gh
  local herdr_env=0 herdr=0 main_ok=0 dirty=0 helper_present=0 beads=0 entire=0 top
  cwd="$(_git_backend_realpath "$PWD")"
  [[ -n "${HC_TERMINAL_ID:-}" ]] && herdr_env=1
  if handoff_herdr_app_ok; then
    herdr=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_is_main_checkout "$cwd"; then
    main_ok=1
  fi
  if command -v git >/dev/null 2>&1 && handoff_main_is_dirty "$cwd"; then
    dirty=1
  fi
  if command -v git >/dev/null 2>&1; then
    local info_rc=0
    backend="$(git_backend "$cwd")" || info_rc=$?
    [[ "$info_rc" -ne 130 ]] || exit 130
    # Entire captures the agents' sessions here, whatever the backend.
    top="$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)" && git_backend_entire_capture "$top" && entire=1
  fi
  branch="$(git -C "$cwd" branch --show-current 2>/dev/null || true)"
  helper="${HOME}/.config/worktrunk/herdr-layout.sh"
  [[ -f "$helper" ]] && helper_present=1
  if [[ "$dirty" -eq 1 ]]; then
    default_copy="dirty"
  else
    default_copy="clean"
  fi
  if handoff_bin_present "$(handoff_bd_bin)"; then
    beads=1
  fi
  jq -nc \
    --arg cwd "$cwd" \
    --arg branch "$branch" \
    --arg default_copy "$default_copy" \
    --arg helper "$helper" \
    --arg space "$(handoff_shown_space 2>/dev/null || true)" \
    --argjson herdr_env "$(handoff_bool_json "$herdr_env")" \
    --argjson herdr "$(handoff_bool_json "$herdr")" \
    --argjson main_checkout "$(handoff_bool_json "$main_ok")" \
    --argjson dirty "$(handoff_bool_json "$dirty")" \
    --arg git "$backend" \
    --argjson entire "$(handoff_bool_json "$entire")" \
    --argjson helper_present "$(handoff_bool_json "$helper_present")" \
    --argjson beads "$(handoff_bool_json "$beads")" \
    '{
      herdr:$herdr,
      herdr_env:$herdr_env,
      main_checkout:$main_checkout,
      cwd:$cwd,
      branch:$branch,
      dirty:$dirty,
      git:$git,
      entire:$entire,
      default_copy:$default_copy,
      helper:$helper,
      helper_present:$helper_present,
      space:$space,
      beads:$beads,
      stages:["bstack","autopilot"]
    }'
}

handoff_spawn_main() {
  local branch="" dirty="auto" issue="" issue_title="" prompt main sibling label intro copied=0 backend=gh
  local helper="${HOME:-}/.config/worktrunk/herdr-layout.sh"
  local json keep_space info=0 started=0 space="" desk=""
  local stage="" worktree="" resume="" dry=0
  local base="" fresh="" model="" target="" fork_reason="" adopt_reason="" session="" lock="" prior path prior_main created=""
  local existing=0 reuse=0 released="" role=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help) handoff_usage ;;
      --info) info=1; shift ;;
      --dirty) dirty=1; shift ;;
      --clean) dirty=0; shift ;;
      --issue)
        [[ $# -ge 2 ]] || handoff_usage
        issue="$2"
        shift 2
        ;;
      --stage)
        [[ $# -ge 2 ]] || handoff_usage
        stage="$2"
        shift 2
        ;;
      --worktree)
        [[ $# -ge 2 ]] || handoff_usage
        worktree="$2"
        shift 2
        ;;
      --resume)
        [[ $# -ge 2 ]] || handoff_usage
        resume="$2"
        shift 2
        ;;
      --dry-run) dry=1; shift ;;
      --target) [[ $# -ge 2 ]] || handoff_usage; target="$2"; shift 2 ;;
      --fork-reason) [[ $# -ge 2 ]] || handoff_usage; fork_reason="$2"; shift 2 ;;
      --adopt-reason) [[ $# -ge 2 ]] || handoff_usage; adopt_reason="$2"; shift 2 ;;
      --existing-branch) existing=1; shift ;;
      --reuse-worktree) reuse=1; shift ;;
      --released) [[ $# -ge 2 ]] || handoff_usage; released+="$2"$'\n'; shift 2 ;;
      --branch)
        [[ $# -ge 2 ]] || handoff_usage
        branch="$2"
        shift 2
        ;;
      --base)
        [[ $# -ge 2 ]] || handoff_usage
        base="$2"
        shift 2
        ;;
      --model)
        [[ $# -ge 2 ]] || handoff_usage
        model="$2"
        shift 2
        ;;
      --space)
        [[ $# -ge 2 ]] || handoff_usage
        HANDOFF_SPACE="$2"
        shift 2
        ;;
      --)
        handoff_die "there is no prompt argument; write a beads issue and pass --issue ID"
        ;;
      -*) handoff_usage ;;
      *)
        [[ -z "$branch" ]] || handoff_die "unexpected argument: $1 (the job is a beads issue: --issue ID)"
        branch="$1"
        shift
        ;;
    esac
  done

  if [[ "$info" -eq 1 ]]; then
    command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
    handoff_info_json
    printf '\n'
    return 0
  fi

  [[ "${BERCAIL_ROLE:-}" != shep-bg ]] || handoff_die "background workers cannot dispatch coding or interactive authoring; continue the visible owner"
  [[ "${BERCAIL_ROLE:-}" != shep || ( -n "$branch" && "${BERCAIL_TASK_RESERVED:-}" == 1 ) ]] || handoff_die "Shep coding dispatch must use bercail shep task dispatch (visible original owner, no raw/headless fallback)"
  # Only dispatch has checked that the original desk is gone and recorded why.
  [[ -z "$adopt_reason" || ( -n "$branch" && "${BERCAIL_TASK_RESERVED:-}" == 1 ) ]] \
    || handoff_die "--adopt-reason comes from bercail shep task dispatch with adoptReason, which checks the original desk is gone; run that"
  # Only dispatch has checked the partial worktree is clean with no desk, and that each released issue's desks are gone.
  [[ ( "$reuse" -eq 0 && -z "$released" ) || ( -n "$branch" && "${BERCAIL_TASK_RESERVED:-}" == 1 ) ]] \
    || handoff_die "--reuse-worktree and --released come from bercail shep task dispatch, which checks the partial creation and the superseded issues; run that"
  [[ $((existing + reuse)) -le 1 && ( -z "$adopt_reason" || $((existing + reuse)) -eq 0 ) ]] \
    || handoff_die "--existing-branch, --reuse-worktree and --adopt-reason each pick the checkout; pass one"
  [[ "$existing" -eq 0 || ( -n "$branch" && -z "$base" ) ]] \
    || handoff_die "--existing-branch needs --branch and no --base: the branch is already cut"
  [[ -n "$stage" ]] || handoff_die "--stage bstack|autopilot is required; bercail does not pick a stage"
  [[ "$stage" == bstack || "$stage" == autopilot ]] || handoff_die "unknown stage: $stage"
  [[ -n "$issue" ]] || handoff_die "--issue <beads id> is required; the job lives in that issue"
  handoff_issue_id_ok "$issue" || handoff_die "not a beads issue id: $issue"
  [[ -z "$model" || "$model" =~ ^[^/[:space:]]+/[^[:space:]]+$ ]] \
    || handoff_die "--model takes PROVIDER/MODEL[:thinking], as pi --list-models names it (claude-bridge/claude-opus-5-5:high), not $model"
  [[ -z "$base" || -n "$branch" ]] \
    || handoff_die "--base needs --branch: it picks what the new desk branch is cut from; headless stages run in an existing --worktree"
  if [[ -n "$branch" ]]; then
    # An autopilot desk drives an open PR, so its branch exists: it never cuts one.
    [[ "$stage" != autopilot || ( "$target" == pr:* && $((existing + reuse)) -eq 1 ) || ( "$target" == pr:* && -n "$adopt_reason" ) ]] \
      || handoff_die "stage autopilot --branch starts a desk on an open PR's branch: pass --target pr:N and --existing-branch (or --worktree <the PR's checkout> to run it headless)"
    [[ -z "$resume" && "$dry" -eq 0 && -z "$worktree" ]] \
      || handoff_die "stage $stage --branch starts a desk agent; --resume/--dry-run/--worktree are for headless stages"
    [[ -f "$(handoff_pi_lead_file)" ]] \
      || handoff_die "Pi lead profile is missing ($(handoff_pi_lead_file)). Run bercail update."
    if [[ -n "$model" ]]; then
      model="$(handoff_pi_with_thinking "$model" "$(handoff_pi_lead_file)")"
      handoff_bin_present "${HANDOFF_PI_BIN:-pi}" \
        || handoff_die "pi is not on PATH, so --model $model cannot be checked. Install it (bercail update)."
      handoff_pi_model_check "${HANDOFF_PI_BIN:-pi}" "$(handoff_pi_lead_file)" "$model"
    fi
  else
    [[ "$dirty" == auto ]] || handoff_die "stage $stage does not copy a dirty tree"
    handoff_run_headless "$stage" "$worktree" "$issue" "$resume" "$dry" "$model"
    return 0
  fi

  command -v git >/dev/null 2>&1 || handoff_die "git is required"
  command -v wt >/dev/null 2>&1 || handoff_die "wt (worktrunk) is required"
  command -v jq >/dev/null 2>&1 || handoff_die "jq is required"
  handoff_bin_present "$(handoff_bd_bin)" \
    || handoff_die "bd (beads) is not on PATH; the job is a beads issue (bercail update installs beads)"
  [[ -f "$helper" ]] || handoff_die "missing $helper"

  main="$(_git_backend_realpath "$PWD")"
  handoff_issue_exists "$main" "$issue" || handoff_die "beads issue $issue not found (bd show $issue)"
  issue_title="$(handoff_issue_title "$main" "$issue")"

  handoff_herdr_ok \
    || handoff_die "cannot reach the Herdr app or hc (herdr-app status and hc ls failed); open the app or run: hc server start"
  keep_space="$(handoff_shown_space || true)"

  handoff_is_main_checkout "$main" \
    || handoff_die "cwd is not the main git checkout; refuse to spawn from a linked worktree"

  # Serialize before any space/worktree creation. A stale lock is an explicit
  # recovery decision, never a reason to start another agent on retry.
  if [[ "${BERCAIL_TASK_RESERVED:-}" != 1 ]]; then
    lock="$(git -C "$main" rev-parse --path-format=absolute --git-common-dir)/bercail-task.lock"
    mkdir "$lock" 2>/dev/null || handoff_die "visible dispatch lock held: $lock; inspect the previous spawn before retrying"
    trap 'rmdir "$lock" 2>/dev/null || true' EXIT
  fi
  target="${target:-task:$issue}"
  [[ "$target" =~ ^(task:[A-Za-z0-9._-]+|pr:[1-9][0-9]*)$ ]] || handoff_die "--target must be task:ID or pr:N"
  if [[ -f "${XDG_STATE_HOME:-$HOME/.local/state}/bercail/handoffs.jsonl" ]]; then
    while IFS= read -r prior; do
      path="$(jq -r '.path // empty' <<<"$prior")"
      [[ -n "$path" ]] || continue
      prior_main="$(git_backend_main "$path" 2>/dev/null || jq -r '.repo // empty' <<<"$prior")"
      [[ "$prior_main" == "$main" ]] || continue
      if jq -e --arg i "$issue" '.issue == $i' <<<"$prior" >/dev/null; then
        [[ -z "$adopt_reason" ]] || continue
        handoff_die "original task already has a handoff: $prior; use bercail shep task dispatch, never a new preparation branch"
      fi
      [[ -n "$fork_reason" ]] || handoff_die "logical target already has a handoff: $prior; continue its issue, or pass --fork-reason on a separate exploration issue"
    done < <(jq -c --arg i "$issue" --arg t "$target" --arg released "$released" \
      '($released | split("\n")) as $gone | select((.issue == $i or .target == $t) and (.issue as $x | $gone | index($x) | not))' \
      "${XDG_STATE_HOME:-$HOME/.local/state}/bercail/handoffs.jsonl")
  fi
  session="$(</proc/sys/kernel/random/uuid)"

  if [[ "$dirty" == "auto" ]]; then
    if handoff_main_is_dirty "$main"; then
      dirty=1
    else
      dirty=0
    fi
  fi

  # shellcheck disable=SC1090
  source "$helper"

  if [[ -n "$keep_space" ]]; then
    export WT_HERDR_KEEP_FOCUS="$keep_space"
  fi
  # Before the desk's space, so the sidebar nests it under its repo from the start.
  wt_herdr_main_space "$main" \
    || echo "handoff-spawn: could not open a space on the main checkout $main; the desk's space shows top-level" >&2
  # The post-start hook makes the space only: this starts the desk below.
  if [[ -n "$adopt_reason" || "$reuse" -eq 1 ]]; then
    # The gone desk's checkout, or a partial creation's, as it is; the desk below finds or opens its space.
    sibling="$(handoff_worktree_of "$main" "$branch")" \
      || handoff_die "no existing worktree for $branch; an adoption or a finish continues a checkout, it never creates one"
    [[ "$reuse" -eq 0 ]] || ! handoff_main_is_dirty "$sibling" \
      || handoff_die "$sibling has changes; a partial creation is finished only in a clean worktree"
    dirty=0
  elif [[ "$existing" -eq 1 ]]; then
    handoff_checkout_existing "$main" "$branch"
    dirty=0
  elif [[ -n "$base" ]]; then
    git -C "$main" rev-parse --verify --quiet "$base^{commit}" >/dev/null \
      || handoff_die "--base $base is not a branch or commit in this repo"
    WT_HERDR_NO_DESK=1 wt switch --create "$branch" --base "$base" --no-cd \
      || handoff_die "wt switch --create $branch --base $base failed"
  else
    # A dirty copy is a patch on the local trunk; it stays there.
    [[ "$dirty" == 1 ]] || fresh="$(handoff_fresh_base "$main")"
    WT_HERDR_NO_DESK=1 wt switch --create "$branch" ${fresh:+--base "$fresh"} --no-cd \
      || handoff_die "wt switch --create $branch failed"
  fi
  _wt_herdr_keep_user_focus "$keep_space"
  [[ -n "$adopt_reason" || "$reuse" -eq 1 ]] || sibling="$(handoff_sibling_path "$main" "$branch")" \
    || handoff_die "could not resolve sibling worktree for $branch"
  sibling="$(_git_backend_realpath "$sibling")"

  if [[ "$dirty" == 1 ]]; then
    if handoff_main_is_dirty "$main"; then
      handoff_copy_dirty "$main" "$sibling"
      copied=1
    fi
  fi

  local track_rc=0
  backend="$(git_backend "$sibling")" || track_rc=$?
  [[ "$track_rc" -ne 130 ]] || exit 130
  # An adopted or existing branch already has its place in any stack; so does a
  # PR's branch whose partial creation this finishes. A task branch may not yet.
  [[ -n "$adopt_reason" || "$existing" -eq 1 || ( "$reuse" -eq 1 && "$target" == pr:* ) ]] || case "$backend" in
    gt)
      handoff_track_graphite "$sibling" "$base"
      ;;
    gh)
      [[ -z "$base" ]] || handoff_track_gh "$sibling" "$branch" "$base"
      ;;
    origin)
      [[ -z "$base" ]] || handoff_track_origin "$sibling" "$branch" "$base"
      ;;
    # entire: trails have no stack to track; the trail names its base instead.
  esac

  label="$(_wt_generate_session_name "$sibling")"

  # Before the handoff comment and the desk agent, so both write to the main store.
  handoff_share_main_beads "$sibling"

  # The checkout facts used to be a prompt preamble. They go on the issue now.
  if [[ "$stage" == autopilot ]]; then
    role=autopilot
    intro="$(printf 'bercail handoff: stage autopilot, desk agent pi, linked worktree %s (branch %s, the head of %s). Stay in this checkout. Drive the PR to green with the autopilot skill: you may commit and push its fixes to %s, never force-push, merge, or release. %s When you stop, post your final report on this issue with bd comment %s: what changed, what you ran to prove it, and what is left or blocked.' \
      "$sibling" "$branch" "$target" "$branch" "$(handoff_policy_line "$sibling")" "$issue")"
  else
    intro="$(printf 'bercail handoff: stage %s, desk agent %s, linked worktree %s (branch %s). Stay in this checkout. Stage your changes with git add and leave them uncommitted for human review in tuicr. %s Do not open Review or invoke the review skill; when the desk agent finishes, Review opens itself in this space once the user looks at it. When you stop, post your final report on this issue with bd comment %s: what changed, what you ran to prove it, and what is left or blocked.' \
      "$stage" pi "$sibling" "$branch" "$(handoff_policy_line "$sibling")" "$issue")"
  fi
  if [[ "$backend" == gt ]]; then
    intro="$(printf '%s\nUse gt, not raw git commit/push, unless asked.' "$intro")"
  else
    intro="$(printf '%s\nGit backend is %s. Do not run gt.' "$intro" "$backend")"
    if [[ -n "$base" && "$backend" == gh ]]; then
      intro="$(printf '%s Stack %s on %s with gh stack init or gh stack add, then gh stack submit. Do not open a PR that only targets %s.' "$intro" "$branch" "$base" "$base")"
    elif [[ -n "$base" && "$backend" == origin ]]; then
      intro="$(printf '%s Stack %s on %s with origin stack track --onto and origin pr create --stack-on. Do not open a PR that only targets %s.' "$intro" "$branch" "$base" "$base")"
    elif [[ -n "$base" && "$backend" == entire ]]; then
      intro="$(printf '%s Entire has no stacks: open the trail with entire trail create --base %s, and once %s lands, move it with entire trail retarget.' "$intro" "$base" "$base")"
    fi
  fi
  [[ -z "$adopt_reason" ]] \
    || intro="$(printf '%s\nAdopted: %s. The previous desk is gone; this desk starts a new session in its checkout and inherits none of that session, its requests, or its authority.' "$intro" "${adopt_reason%.}")"
  handoff_issue_comment "$sibling" "$issue" "$intro"

  prompt="$(handoff_issue_prompt "$issue" "$issue_title")"

  # The desk agent runs the lead from lead.json. It gets the one-line prompt
  # through WT_HERDR_AGENT_PROMPT, the issue through WT_HERDR_ISSUE and
  # WT_HERDR_ISSUE_TITLE, --model through WT_HERDR_MODEL, and an autopilot's
  # role through WT_HERDR_ROLE. No file.
  if created="$(WT_HERDR_KEEP_FOCUS="$keep_space" \
    WT_HERDR_ROLE="$role" \
    WT_HERDR_AGENT_PROMPT="$prompt" \
    WT_HERDR_ISSUE="$issue" \
    WT_HERDR_ISSUE_TITLE="$issue_title" \
    WT_HERDR_MODEL="$model" \
    WT_HERDR_SESSION_ID="$session" \
    wt_herdr_handoff_agent "$label" "$sibling")"; then
    started=1
  else
    echo "handoff-spawn: the desk agent did not start; worktree is still $sibling ($label)" >&2
  fi

  space="$(jq -r '.space // empty' <<<"$created" 2>/dev/null || true)"
  desk="$(jq -r '.desk // empty' <<<"$created" 2>/dev/null || true)"
  [[ -n "$space" ]] || space="$(_wt_herdr_find_space "$sibling" 2>/dev/null || true)"
  [[ -n "$desk" || -z "$space" ]] || desk="$(_wt_herdr_space_desk "$space" 2>/dev/null || true)"
  json="$(handoff_result_json "$label" "$sibling" "$branch" "$issue" "$started" "$copied" "$backend" "$stage" pi "$space" "$desk" "$issue_title")"
  json="$(jq -c --arg repo "$main" --arg target "$target" --arg session "$session" --arg fork "$fork_reason" \
    '. + {repo:$repo,target:$target,session:$session} + (if $fork == "" then {} else {forkReason:$fork} end)
     | if .agent_started and (.space // "") != "" and (.desk // "") != "" then .
       else .ok = false | .error = "partial visible creation; inspect these facts, do not relaunch" end' <<<"$json")"
  [[ -z "$base" ]] || json="$(jq -c --arg base "$base" '. + {base:$base}' <<<"$json")"
  [[ -z "$model" ]] || json="$(jq -c --arg model "$model" '. + {model:$model}' <<<"$json")"
  [[ -z "$adopt_reason" ]] || json="$(jq -c --arg r "$adopt_reason" '. + {adoptReason:$r}' <<<"$json")"
  handoff_notify_check "$sibling"
  handoff_remember "$json"
  printf '%s\n' "$json"
  [[ -z "$lock" ]] || rmdir "$lock"
  trap - EXIT
  [[ "$(jq -r .ok <<<"$json")" == true ]]
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  handoff_spawn_main "$@"
fi
